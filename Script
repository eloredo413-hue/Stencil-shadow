--!nonstrict
-- StencilShadowEngine.lua
-- Place this LocalScript inside StarterPlayer -> StarterPlayerScripts
--
-- Stencil Shadow Volume Engine for Roblox (v6: exact silhouettes, curved shadows, cached map shadows)
--
-- What changed from v5:
--   1. Exact shadow shapes (no more blocky approximations):
--      - v5 filled each shadow polygon with a few rotated rectangles and 3 scanline strips. That left
--        gaps, jagged edges, and a "blocky" look, especially on characters.
--      - v6 cuts every shadow polygon into triangles. Each triangle is split into two right triangles,
--        and each right triangle is drawn exactly with ONE square Frame plus a hard-edged UIGradient.
--        The pieces overlap by about half a pixel, so there are no seams. Since everything sits in one
--        CanvasGroup per tile, overlapping shadows merge into a single flat silhouette instead of
--        stacking darker.
--   2. Curved shadows from real silhouettes:
--      - Each caster is sampled along its true silhouette as seen from the sun, then projected:
--          * Balls / sphere meshes      -> exact ellipses (ellipsoid silhouette)
--          * Cylinders                  -> exact capsule/oval shadows (both end caps projected)
--          * Classic heads              -> rounded-cylinder silhouette (the round head blob)
--          * R15 heads, hair, hats      -> smooth ellipsoids
--          * MeshParts / unions         -> rounded boxes
--          * Character limbs            -> slightly rounded boxes, so the body reads as one figure
--          * Map bricks / wedges        -> exact sharp corners
--   3. Faster rendering:
--      - Map shadows are CACHED. A map part's shadow is only rebuilt when the part moves, a surface it
--        lands on moves, or the sun moves. Rebuilds are spread over frames (MapRebuildBudget).
--      - Frame properties are only written when they actually change. A tile that holds only static
--        shadows gets no writes, so its CanvasGroup never re-renders.
--      - Draw order is stable (static map shadows first, then characters), so moving characters
--        don't shuffle the static frames.
--      - Far-away tiles use lower canvas resolution (LOD), and far-away characters update less often.
--   4. More of the map gets shadows:
--      - More map casters (MaxMapCasters), a larger radius, and receiver rays fired from every corner
--        of a caster, so large parts throw their shadows across every surface they reach.
--      - Invisible parts (Transparency >= 0.95) are skipped as receivers instead of catching shadows
--        in mid-air.
--   5. Cliff/ledge bending and wall clipping are kept from v5. Stacked surfaces (steps, ledges) no
--      longer wrongly delete shadows on the floor below.
--
-- NOTE: Each right triangle is a Frame plus a UIGradient whose Transparency jumps from 0 to 1 at the
-- midpoint. No image assets are needed.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

-- ============================================================================
-- CONFIGURATION
-- ============================================================================
local CONFIG = {
	-- Classic Stencil Visuals
	ShadowColor = Color3.fromRGB(6, 6, 10),      -- Stencil ink color
	ShadowGroupTransparency = 0.35,              -- Shadow darkness (0 = pitch black, 1 = invisible)
	SurfaceOffset = 0.004,                       -- Offset above surface so SurfaceGui never Z-fights

	-- Shared Tiles & Resolution LOD
	SharedTileSize = 64,                         -- Tile size (studs) on large floors/walls
	MaxCanvasPixels = 1024,                      -- Max canvas resolution per tile
	LodPixelsPerStud = { 14, 8, 4 },             -- Near / mid / far tile sharpness
	LodDistances = { 90, 180 },                  -- Distance (studs) where near->mid and mid->far switch
	LodHysteresis = 12,                          -- Prevents tiles flipping between LOD levels

	-- Silhouette Quality
	EdgeFeatherPx = 0.55,                        -- Overlap between triangle pieces (hides seams)
	MinVertexSpacingPx = 0.9,                    -- Merge outline points closer than this (fewer frames)
	CurveSegments = 20,                          -- Points around a ball / ellipsoid silhouette
	CylinderSegments = 16,                       -- Points around each cylinder/head ring
	RoundCornerSegments = 6,                     -- Points per rounded-box corner
	CharacterLimbRounding = 0.14,                -- Corner radius (studs) for character limbs/torso
	MeshRoundingFraction = 0.42,                 -- MeshPart/Union corner radius as a fraction of its half-size
	AccessoryShrink = 0.85,                      -- Hair/hat ellipsoid size relative to the handle part

	-- Coverage & Performance Budgets
	MaxShadowDistance = 120,                     -- Max distance (studs) a shadow projects along the light ray
	MaxRenderDistance = 260,                     -- Radius around the player where shadows are drawn
	MaxMapCasters = 350,                         -- Map parts that cast shadows at the same time
	MapRefreshInterval = 0.25,                   -- Seconds between re-picking the nearest map casters
	MapRebuildBudget = 40,                       -- Map shadows (re)built per frame; the rest stay cached
	LightRebuildAngle = 0.4,                     -- Degrees the sun must move before map shadows rebuild
	FarCharacterDistance = 120,                  -- Characters farther than this update less often
	FarCharacterUpdateEvery = 3,                 -- ...every N frames
	WallObstructionTolerance = 0.25,             -- Depth tolerance (studs) before an obstacle blocks a receiver

	-- Caster Filtering
	IncludeMapParts = true,                      -- Map parts cast stencil shadows
	MaxCasterPartSize = 140,                     -- Flat baseplates wider than this never cast
	MinCasterPartSize = 0.25,                    -- Include hands, feet, tools, and accessories

	-- Pre-Warming (Instant Load, Zero Stutter)
	PrewarmCanvasSlots = 12,                     -- Tile canvases created at startup
	PrewarmTrianglesPerSlot = 160,               -- Triangle frames created per canvas at startup

	-- Lighting Overhaul
	ForceDisableNativeShadows = true,            -- Disables Roblox's blurry shadow maps so only stencil shadows show
	ConfigureClassicLighting = true,             -- Sets crisp directional contrast lighting
}

-- ============================================================================
-- LIGHTING SETUP
-- ============================================================================
local function enforceStencilLighting()
	if CONFIG.ForceDisableNativeShadows then
		Lighting.GlobalShadows = false
		Lighting.ShadowSoftness = 0
	end
	if CONFIG.ConfigureClassicLighting then
		Lighting.EnvironmentDiffuseScale = 0.25
		Lighting.EnvironmentSpecularScale = 0.2
		Lighting.Ambient = Color3.fromRGB(96, 100, 110)
		Lighting.OutdoorAmbient = Color3.fromRGB(116, 120, 130)
		Lighting.Brightness = 2.15
	end
end

enforceStencilLighting()

-- ============================================================================
-- PERSISTENT SURFACEGUI + CANVASGROUP POOL (TRIANGLE FRAMES)
-- ============================================================================
local existingContainer = Workspace:FindFirstChild("_StencilShadowRenderer")
if existingContainer then
	existingContainer:Destroy()
end

local shadowContainer = Instance.new("Folder")
shadowContainer.Name = "_StencilShadowRenderer"
shadowContainer.Parent = Workspace

-- Opaque on one side of the gradient's midpoint, transparent on the other: a perfectly straight cut.
local HARD_EDGE = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.5, 0),
	NumberSequenceKeypoint.new(0.5005, 1),
	NumberSequenceKeypoint.new(1, 1),
})

local STRIDE = 7 -- Numbers per triangle command: x, y, size, rotation, gradRotation, offsetX, offsetY
local PARKED_CF = CFrame.new(0, -10000, 0)

type Slot = {
	carrierPart: Part,
	surfaceGui: SurfaceGui,
	canvasGroup: CanvasGroup,
	frames: { Frame },
	grads: { UIGradient },
	last: { number },    -- Last values written to each frame (skip unchanged writes)
	count: number,
	prevCount: number,
	usedThisFrame: boolean,
}

local activeSlotsByKey: { [string]: Slot } = {}
local freeSlotPool: { Slot } = {}

local function createTriangleFrame(parentCanvas: CanvasGroup): (Frame, UIGradient)
	local f = Instance.new("Frame")
	f.Name = "T"
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundColor3 = CONFIG.ShadowColor
	f.BackgroundTransparency = 0
	f.BorderSizePixel = 0
	f.Visible = false

	local g = Instance.new("UIGradient")
	g.Transparency = HARD_EDGE
	g.Parent = f

	f.Parent = parentCanvas
	return f, g
end

local function createNewCanvasSlot(prewarm: number): Slot
	local carrier = Instance.new("Part")
	carrier.Name = "ShadowSurfaceCarrier"
	carrier.Anchored = true
	carrier.CanCollide = false
	carrier.CanQuery = false
	carrier.CanTouch = false
	carrier.CastShadow = false
	carrier.Massless = true
	carrier.Transparency = 1
	carrier.Size = Vector3.new(1, 1, 0.004)
	carrier.CFrame = PARKED_CF

	local sgui = Instance.new("SurfaceGui")
	sgui.Name = "StencilSurfaceGui"
	sgui.Face = Enum.NormalId.Back -- +Z axis of the carrier is the surface normal
	sgui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sgui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sgui.ClipsDescendants = true
	sgui.LightInfluence = 0
	sgui.Brightness = 1
	sgui.MaxDistance = CONFIG.MaxRenderDistance + 60
	sgui.Enabled = true
	sgui.Parent = carrier

	local cg = Instance.new("CanvasGroup")
	cg.Name = "StencilCompositor"
	cg.Size = UDim2.fromScale(1, 1)
	cg.Position = UDim2.fromScale(0, 0)
	cg.BackgroundTransparency = 1
	cg.BorderSizePixel = 0
	cg.GroupColor3 = CONFIG.ShadowColor
	cg.GroupTransparency = CONFIG.ShadowGroupTransparency
	cg.Parent = sgui

	local frames = table.create(prewarm)
	local grads = table.create(prewarm)
	for i = 1, prewarm do
		frames[i], grads[i] = createTriangleFrame(cg)
	end

	carrier.Parent = shadowContainer

	return {
		carrierPart = carrier,
		surfaceGui = sgui,
		canvasGroup = cg,
		frames = frames,
		grads = grads,
		last = {},
		count = 0,
		prevCount = 0,
		usedThisFrame = false,
	}
end

for _ = 1, CONFIG.PrewarmCanvasSlots do
	table.insert(freeSlotPool, createNewCanvasSlot(CONFIG.PrewarmTrianglesPerSlot))
end

local function acquirePersistentCanvasSlot(key: string): Slot
	local slot = activeSlotsByKey[key]
	if slot then
		slot.usedThisFrame = true
		return slot
	end

	local newSlot = table.remove(freeSlotPool) or createNewCanvasSlot(48)
	newSlot.usedThisFrame = true
	newSlot.count = 0
	activeSlotsByKey[key] = newSlot
	return newSlot
end

-- Writes `n` numbers worth of triangle commands into the slot, touching only properties that changed.
local function emitCommands(slot: Slot, cmds: { number }, n: number)
	local frames = slot.frames
	local grads = slot.grads
	local last = slot.last
	local count = slot.count
	local prevCount = slot.prevCount

	for b = 0, n - STRIDE, STRIDE do
		count += 1
		local f = frames[count]
		local g = grads[count]
		if not f then
			f, g = createTriangleFrame(slot.canvasGroup)
			frames[count] = f
			grads[count] = g
		end

		local lb = (count - 1) * STRIDE
		local x, y, s = cmds[b + 1], cmds[b + 2], cmds[b + 3]
		local r, gr = cmds[b + 4], cmds[b + 5]
		local ox, oy = cmds[b + 6], cmds[b + 7]

		if last[lb + 1] ~= x or last[lb + 2] ~= y then
			f.Position = UDim2.fromOffset(x, y)
			last[lb + 1] = x
			last[lb + 2] = y
		end
		if last[lb + 3] ~= s then
			f.Size = UDim2.fromOffset(s, s)
			last[lb + 3] = s
		end
		if last[lb + 4] ~= r then
			f.Rotation = r
			last[lb + 4] = r
		end
		if last[lb + 5] ~= gr then
			g.Rotation = gr
			last[lb + 5] = gr
		end
		if last[lb + 6] ~= ox or last[lb + 7] ~= oy then
			g.Offset = Vector2.new(ox, oy)
			last[lb + 6] = ox
			last[lb + 7] = oy
		end
		if count > prevCount then
			f.Visible = true
		end
	end

	slot.count = count
end

local function finalizeCanvasSlotsForFrame()
	for key, slot in pairs(activeSlotsByKey) do
		local keep = if slot.usedThisFrame then slot.count else 0
		local frames = slot.frames
		for i = keep + 1, slot.prevCount do
			frames[i].Visible = false
		end
		slot.prevCount = keep
		slot.count = 0

		if slot.usedThisFrame then
			slot.usedThisFrame = false
		else
			slot.carrierPart.CFrame = PARKED_CF
			activeSlotsByKey[key] = nil
			table.insert(freeSlotPool, slot)
		end
	end
end

-- ============================================================================
-- EXACT TRIANGLE RASTERIZATION (FRAME + HARD UIGRADIENT)
-- ============================================================================
-- A right triangle with legs a (along X) and b (along Y) equals a square of side max(a, b) cut by
-- its hypotenuse. The square Frame supplies both legs; the UIGradient cut supplies the hypotenuse.
-- Every edge is pushed out by FEATHER pixels so neighbouring pieces overlap without seams.
local FEATHER = CONFIG.EdgeFeatherPx

local function pushRightTriangle(out: { number }, n: number, rx: number, ry: number, ax: number, ay: number, bx: number, by: number): number
	local ux, uy = ax - rx, ay - ry
	local vx, vy = bx - rx, by - ry
	local a = math.sqrt(ux * ux + uy * uy)
	local b = math.sqrt(vx * vx + vy * vy)
	if a < 0.08 or b < 0.08 then
		return n
	end
	ux, uy = ux / a, uy / a
	vx, vy = vx / b, vy / b
	if ux * vy - uy * vx < 0 then
		ux, uy, vx, vy = vx, vy, ux, uy
		a, b = b, a
	end
	-- Frame local +Y must be local +X rotated 90 degrees clockwise (screen Y points down)
	vx, vy = -uy, ux

	local e = FEATHER
	local s = math.max(a, b) + 2 * e
	local h = s * 0.5 - e
	local L = math.sqrt(a * a + b * b)
	local nx, ny = b / L, a / L
	local d = a * b / L + e - (nx + ny) * h

	out[n + 1] = rx + (ux + vx) * h
	out[n + 2] = ry + (uy + vy) * h
	out[n + 3] = s
	out[n + 4] = math.deg(math.atan2(uy, ux))
	out[n + 5] = math.deg(math.atan2(ny, nx))
	out[n + 6] = nx * d / s
	out[n + 7] = ny * d / s
	return n + STRIDE
end

local function pushTriangle(out: { number }, n: number, x1: number, y1: number, x2: number, y2: number, x3: number, y3: number): number
	local area2 = (x2 - x1) * (y3 - y1) - (y2 - y1) * (x3 - x1)
	if math.abs(area2) < 0.35 then
		return n
	end

	local d12 = (x2 - x1) ^ 2 + (y2 - y1) ^ 2
	local d23 = (x3 - x2) ^ 2 + (y3 - y2) ^ 2
	local d31 = (x1 - x3) ^ 2 + (y1 - y3) ^ 2

	-- Split along the altitude onto the longest edge (its foot always lands inside that edge)
	local px, py, qx, qy, ox, oy
	if d12 >= d23 and d12 >= d31 then
		px, py, qx, qy, ox, oy = x1, y1, x2, y2, x3, y3
	elseif d23 >= d31 then
		px, py, qx, qy, ox, oy = x2, y2, x3, y3, x1, y1
	else
		px, py, qx, qy, ox, oy = x3, y3, x1, y1, x2, y2
	end

	local ex, ey = qx - px, qy - py
	local t = ((ox - px) * ex + (oy - py) * ey) / (ex * ex + ey * ey)
	local fx, fy = px + ex * t, py + ey * t

	n = pushRightTriangle(out, n, fx, fy, ox, oy, px, py)
	n = pushRightTriangle(out, n, fx, fy, ox, oy, qx, qy)
	return n
end

-- ============================================================================
-- 2D GEOMETRY
-- ============================================================================
type Vec2 = Vector2
type Vec3 = Vector3

local function cross2D(a: Vec2, b: Vec2, c: Vec2): number
	return (b.X - a.X) * (c.Y - a.Y) - (b.Y - a.Y) * (c.X - a.X)
end

local function sortByXY(a: Vec2, b: Vec2): boolean
	if a.X ~= b.X then
		return a.X < b.X
	end
	return a.Y < b.Y
end

local function computeConvexHull2D(pts: { Vec2 }, n: number): { Vec2 }
	if n < 3 then
		return {}
	end
	for i = #pts, n + 1, -1 do
		pts[i] = nil
	end
	table.sort(pts, sortByXY)

	local hull: { Vec2 } = table.create(n + 1)
	local k = 0
	for i = 1, n do
		local p = pts[i]
		while k >= 2 and cross2D(hull[k - 1], hull[k], p) <= 1e-6 do
			hull[k] = nil
			k -= 1
		end
		k += 1
		hull[k] = p
	end
	local lowerSize = k + 1
	for i = n - 1, 1, -1 do
		local p = pts[i]
		while k >= lowerSize and cross2D(hull[k - 1], hull[k], p) <= 1e-6 do
			hull[k] = nil
			k -= 1
		end
		k += 1
		hull[k] = p
	end
	hull[k] = nil -- Last point repeats the first
	return hull
end

local function clipEdge(input: { Vec2 }, axisIsX: boolean, limit: number, keepLess: boolean): { Vec2 }
	local count = #input
	if count == 0 then
		return input
	end
	local output: { Vec2 } = table.create(count + 2)
	local s = input[count]
	local sVal = if axisIsX then s.X else s.Y
	local sIn = if keepLess then sVal <= limit else sVal >= limit

	for i = 1, count do
		local e = input[i]
		local eVal = if axisIsX then e.X else e.Y
		local eIn = if keepLess then eVal <= limit else eVal >= limit
		if eIn ~= sIn then
			local t = (limit - sVal) / (eVal - sVal)
			table.insert(output, s + (e - s) * t)
		end
		if eIn then
			table.insert(output, e)
		end
		s, sVal, sIn = e, eVal, eIn
	end
	return output
end

local function clipPolygonToRect2D(poly: { Vec2 }, halfU: number, halfV: number): { Vec2 }
	local out = clipEdge(poly, true, -halfU, false)
	out = clipEdge(out, true, halfU, true)
	out = clipEdge(out, false, -halfV, false)
	out = clipEdge(out, false, halfV, true)
	return out
end

local function clipPolygonHalfPlane2D(poly: { Vec2 }, planePt: Vec2, planeNormal: Vec2): { Vec2 }
	local count = #poly
	if count < 3 then
		return {}
	end
	local output: { Vec2 } = table.create(count + 2)
	local s = poly[count]
	local sDist = (s - planePt):Dot(planeNormal)

	for i = 1, count do
		local e = poly[i]
		local eDist = (e - planePt):Dot(planeNormal)
		if (eDist >= 0) ~= (sDist >= 0) then
			local t = sDist / (sDist - eDist)
			table.insert(output, s + (e - s) * t)
		end
		if eDist >= 0 then
			table.insert(output, e)
		end
		s, sDist = e, eDist
	end
	return output
end

-- ============================================================================
-- RECEIVER PLANES & SHARED TILES (WITH RESOLUTION LOD)
-- ============================================================================
export type ReceiverPlane = {
	part: BasePart,
	origin: Vec3,
	normal: Vec3,
	tangentU: Vec3,
	tangentV: Vec3,
	halfU: number,
	halfV: number,
	baseKey: string,
	isTiled: boolean,
}

export type ReceiverTile = {
	centerU: number,
	centerV: number,
	halfU: number,
	halfV: number,
	canvasW: number,
	canvasH: number,
	scaleX: number,
	scaleY: number,
	key: string,
	slot: Slot,
}

local frameTilesByKey: { [string]: ReceiverTile } = {}
local tileLodLevel: { [string]: number } = {}
local currentFocusPos = Vector3.zero

local function chooseTileLod(key: string, distance: number): number
	local dists = CONFIG.LodDistances
	local hyst = CONFIG.LodHysteresis
	local cur = tileLodLevel[key]
	local level = 1
	for i = 1, #dists do
		local threshold = dists[i]
		if cur then
			threshold += if cur > i then -hyst else hyst
		end
		if distance > threshold then
			level = i + 1
		end
	end
	tileLodLevel[key] = level
	return level
end

local function getOrCreateReceiverTile(plane: ReceiverPlane, tx: number, ty: number): ReceiverTile?
	local tileSize = CONFIG.SharedTileSize
	local tileKey = if plane.isTiled then plane.baseKey .. "_T_" .. tx .. "_" .. ty else plane.baseKey

	local existing = frameTilesByKey[tileKey]
	if existing then
		return existing
	end

	local uMin, uMax, vMin, vMax
	if plane.isTiled then
		uMin = math.max(-plane.halfU, tx * tileSize - tileSize * 0.5)
		uMax = math.min(plane.halfU, tx * tileSize + tileSize * 0.5)
		vMin = math.max(-plane.halfV, ty * tileSize - tileSize * 0.5)
		vMax = math.min(plane.halfV, ty * tileSize + tileSize * 0.5)
		if uMax <= uMin + 0.2 or vMax <= vMin + 0.2 then
			return nil
		end
	else
		uMin, uMax = -plane.halfU, plane.halfU
		vMin, vMax = -plane.halfV, plane.halfV
	end

	local centerU = (uMin + uMax) * 0.5
	local centerV = (vMin + vMax) * 0.5
	local halfU = (uMax - uMin) * 0.5
	local halfV = (vMax - vMin) * 0.5
	local tileOrigin = plane.origin + plane.tangentU * centerU + plane.tangentV * centerV

	local tileDist = math.max(0, (tileOrigin - currentFocusPos).Magnitude - math.max(halfU, halfV))
	local pps = CONFIG.LodPixelsPerStud[chooseTileLod(tileKey, tileDist)]
	local rawW = math.clamp(math.ceil(halfU * 2 * pps), 16, CONFIG.MaxCanvasPixels)
	local rawH = math.clamp(math.ceil(halfV * 2 * pps), 16, CONFIG.MaxCanvasPixels)

	local slot = acquirePersistentCanvasSlot(tileKey)
	local targetSize = Vector3.new(halfU * 2, halfV * 2, 0.004)
	local targetCF = CFrame.fromMatrix(
		tileOrigin + plane.normal * CONFIG.SurfaceOffset,
		plane.tangentU,
		plane.tangentV,
		plane.normal
	)
	local targetCanvas = Vector2.new(rawW, rawH)

	if slot.carrierPart.Size ~= targetSize then
		slot.carrierPart.Size = targetSize
	end
	if slot.carrierPart.CFrame ~= targetCF then
		slot.carrierPart.CFrame = targetCF
	end
	if slot.surfaceGui.CanvasSize ~= targetCanvas then
		slot.surfaceGui.CanvasSize = targetCanvas
	end

	local tile: ReceiverTile = {
		centerU = centerU,
		centerV = centerV,
		halfU = halfU,
		halfV = halfV,
		canvasW = rawW,
		canvasH = rawH,
		scaleX = rawW / (halfU * 2),
		scaleY = rawH / (halfV * 2),
		key = tileKey,
		slot = slot,
	}
	frameTilesByKey[tileKey] = tile
	return tile
end

local tileListScratch: { ReceiverTile } = {}

local function getOverlappingTiles(plane: ReceiverPlane, minU: number, maxU: number, minV: number, maxV: number): { ReceiverTile }
	table.clear(tileListScratch)
	if not plane.isTiled then
		local t = getOrCreateReceiverTile(plane, 0, 0)
		if t then
			tileListScratch[1] = t
		end
		return tileListScratch
	end

	local tileSize = CONFIG.SharedTileSize
	local tx0 = math.floor((minU + tileSize * 0.5) / tileSize)
	local tx1 = math.floor((maxU + tileSize * 0.5) / tileSize)
	local ty0 = math.floor((minV + tileSize * 0.5) / tileSize)
	local ty1 = math.floor((maxV + tileSize * 0.5) / tileSize)

	for tx = tx0, tx1 do
		for ty = ty0, ty1 do
			local tile = getOrCreateReceiverTile(plane, tx, ty)
			if tile then
				table.insert(tileListScratch, tile)
			end
		end
	end
	return tileListScratch
end

-- Converts a plane-space shadow polygon into triangle commands for one tile. Returns the number count.
local pxX: { number } = {}
local pxY: { number } = {}

local function buildTileCommands(poly: { Vec2 }, tile: ReceiverTile, out: { number }): number
	local halfU, halfV = tile.halfU, tile.halfV
	local sx, sy = tile.scaleX, tile.scaleY
	local cu, cv = tile.centerU, tile.centerV
	local w, h = tile.canvasW, tile.canvasH
	local minSp2 = CONFIG.MinVertexSpacingPx * CONFIG.MinVertexSpacingPx

	-- 1. Map to pixels, merging points that are too close together
	local m = 0
	local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
	for i = 1, #poly do
		local p = poly[i]
		local x = (p.X - cu + halfU) * sx
		local y = (halfV - (p.Y - cv)) * sy
		if m == 0 or (x - pxX[m]) ^ 2 + (y - pxY[m]) ^ 2 >= minSp2 then
			m += 1
			pxX[m] = x
			pxY[m] = y
			if x < minX then minX = x end
			if x > maxX then maxX = x end
			if y < minY then minY = y end
			if y > maxY then maxY = y end
		end
	end
	if m >= 2 and (pxX[m] - pxX[1]) ^ 2 + (pxY[m] - pxY[1]) ^ 2 < minSp2 then
		m -= 1
	end
	if m < 3 or maxX < 0 or minX > w or maxY < 0 or minY > h then
		return 0
	end

	-- 2. Drop nearly collinear points (they only add frames)
	local k = 0
	for i = 1, m do
		local ax, ay = pxX[if k > 0 then k else m], pxY[if k > 0 then k else m]
		local bx, by = pxX[i], pxY[i]
		local cx, cy = pxX[(i % m) + 1], pxY[(i % m) + 1]
		local ex, ey = cx - ax, cy - ay
		local len = math.sqrt(ex * ex + ey * ey)
		local dev = if len > 1e-6 then math.abs((bx - ax) * ey - (by - ay) * ex) / len else 0
		if dev >= 0.25 then
			k += 1
			pxX[k] = bx
			pxY[k] = by
		end
	end
	if k < 3 then
		return 0
	end

	-- 3. Triangle fan, skipping triangles that fall entirely off this tile's canvas
	local n = 0
	local x1, y1 = pxX[1], pxY[1]
	for i = 2, k - 1 do
		local x2, y2, x3, y3 = pxX[i], pxY[i], pxX[i + 1], pxY[i + 1]
		if not ((x1 < -1 and x2 < -1 and x3 < -1) or (x1 > w + 1 and x2 > w + 1 and x3 > w + 1)
			or (y1 < -1 and y2 < -1 and y3 < -1) or (y1 > h + 1 and y2 > h + 1 and y3 > h + 1))
		then
			n = pushTriangle(out, n, x1, y1, x2, y2, x3, y3)
		end
	end
	return n
end

local function polygonBounds(poly: { Vec2 }): (number, number, number, number)
	local minU, maxU, minV, maxV = math.huge, -math.huge, math.huge, -math.huge
	for i = 1, #poly do
		local p = poly[i]
		if p.X < minU then minU = p.X end
		if p.X > maxU then maxU = p.X end
		if p.Y < minV then minV = p.Y end
		if p.Y > maxV then maxV = p.Y end
	end
	return minU, maxU, minV, maxV
end

type Draw = {
	plane: ReceiverPlane,
	poly: { Vec2 },
	tileCache: { [string]: { w: number, h: number, n: number, cmds: { number } } }?,
}

local dynamicCmdScratch: { number } = {}

local function emitDraw(draw: Draw)
	local plane = draw.plane
	local minU, maxU, minV, maxV = polygonBounds(draw.poly)
	local tiles = getOverlappingTiles(plane, minU, maxU, minV, maxV)
	local cache = draw.tileCache

	for i = 1, #tiles do
		local tile = tiles[i]
		if cache then
			local entry = cache[tile.key]
			if not entry or entry.w ~= tile.canvasW or entry.h ~= tile.canvasH then
				local cmds = {}
				entry = { w = tile.canvasW, h = tile.canvasH, n = buildTileCommands(draw.poly, tile, cmds), cmds = cmds }
				cache[tile.key] = entry
			end
			if entry.n > 0 then
				emitCommands(tile.slot, entry.cmds, entry.n)
			end
		else
			local n = buildTileCommands(draw.poly, tile, dynamicCmdScratch)
			if n > 0 then
				emitCommands(tile.slot, dynamicCmdScratch, n)
			end
		end
	end
end

-- ============================================================================
-- RECEIVER PLANE EXTRACTION
-- ============================================================================
local function extractReceiverPlane(part: BasePart, hitNormal: Vec3, hitPos: Vec3): ReceiverPlane?
	local cf = part.CFrame
	local size = part.Size * 0.5
	local localNormal = cf:VectorToObjectSpace(hitNormal)

	local absX = math.abs(localNormal.X)
	local absY = math.abs(localNormal.Y)
	local absZ = math.abs(localNormal.Z)

	local origin, normal, tangentU, tangentV, halfU, halfV, baseKey
	local id = part:GetDebugId()

	if part:IsA("Part") and part.Shape == Enum.PartType.Block then
		if absY >= absX and absY >= absZ then
			local signY = if localNormal.Y >= 0 then 1 else -1
			normal = cf.UpVector * signY
			origin = cf.Position + normal * size.Y
			tangentU = cf.RightVector
			tangentV = normal:Cross(tangentU).Unit
			halfU = size.X
			halfV = size.Z
			baseKey = id .. (if signY > 0 then "_Top" else "_Bottom")
		elseif absX >= absY and absX >= absZ then
			local signX = if localNormal.X >= 0 then 1 else -1
			normal = cf.RightVector * signX
			origin = cf.Position + normal * size.X
			tangentU = -cf.LookVector * signX
			tangentV = normal:Cross(tangentU).Unit
			halfU = size.Z
			halfV = size.Y
			baseKey = id .. (if signX > 0 then "_Right" else "_Left")
		else
			local signZ = if localNormal.Z >= 0 then 1 else -1
			normal = -cf.LookVector * signZ
			origin = cf.Position + normal * size.Z
			tangentU = cf.RightVector * signZ
			tangentV = normal:Cross(tangentU).Unit
			halfU = size.X
			halfV = size.Y
			baseKey = id .. (if signZ > 0 then "_Back" else "_Front")
		end
	elseif part:IsA("WedgePart") then
		normal = hitNormal.Unit
		tangentU = cf.RightVector
		tangentV = normal:Cross(tangentU).Unit
		if absY > 0.1 and absZ > 0.1 then
			origin = cf.Position
			halfU = size.X
			halfV = math.sqrt(size.Y * size.Y + size.Z * size.Z)
			baseKey = id .. "_Slope"
		else
			origin = hitPos
			halfU = math.max(size.X, size.Y, size.Z)
			halfV = halfU
			baseKey = id .. "_WedgeFlat"
		end
	else
		-- Terrain, meshes, unions, balls, cylinders: a tangent patch snapped to a 24-stud grid
		normal = hitNormal.Unit
		local up = if math.abs(normal.Y) < 0.99 then Vector3.yAxis else Vector3.xAxis
		tangentU = up:Cross(normal).Unit
		tangentV = normal:Cross(tangentU).Unit
		local gx = math.floor(hitPos.X / 24)
		local gy = math.floor(hitPos.Y / 24)
		local gz = math.floor(hitPos.Z / 24)
		local snapped = Vector3.new((gx + 0.5) * 24, (gy + 0.5) * 24, (gz + 0.5) * 24)
		origin = snapped - normal * (snapped - hitPos):Dot(normal)
		halfU = 24
		halfV = 24
		baseKey = string.format("Patch_%d_%d_%d_%.1f_%.1f_%.1f", gx, gy, gz, normal.X, normal.Y, normal.Z)
	end

	local tileThreshold = CONFIG.SharedTileSize * 0.65
	return {
		part = part,
		origin = origin,
		normal = normal,
		tangentU = tangentU,
		tangentV = tangentV,
		halfU = halfU,
		halfV = halfV,
		baseKey = baseKey,
		isTiled = (halfU > tileThreshold) or (halfV > tileThreshold),
	}
end

-- ============================================================================
-- CASTER SHAPES & TRUE SILHOUETTE SAMPLING
-- ============================================================================
-- Every caster turns into a cloud of 3D points on its silhouette (as seen from the light). Projecting
-- the cloud onto a surface and taking the convex hull gives the exact shadow outline, curves included.
type Caster = {
	kind: string,       -- "Box" | "Points" | "Ellipsoid" | "RoundBox" | "RoundCyl"
	cf: CFrame,
	half: Vec3,         -- Box/RoundBox half extents, Ellipsoid radii
	verts: { Vec3 }?,   -- Points
	radius: number,     -- RoundBox corner radius / RoundCyl radius
	axisX: boolean,     -- RoundCyl: axis is local X (else local Y)
	halfLen: number,    -- RoundCyl half length
	rounding: number,   -- RoundCyl edge rounding
	part: BasePart,
}

local trigCache: { [number]: { cos: { number }, sin: { number } } } = {}
local function getTrig(segments: number)
	local t = trigCache[segments]
	if not t then
		t = { cos = table.create(segments), sin = table.create(segments) }
		for i = 1, segments do
			local a = (i - 1) / segments * math.pi * 2
			t.cos[i] = math.cos(a)
			t.sin[i] = math.sin(a)
		end
		trigCache[segments] = t
	end
	return t
end

local function perpendicularBasis(dir: Vec3): (Vec3, Vec3)
	local ref = if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis
	local e1 = dir:Cross(ref).Unit
	local e2 = dir:Cross(e1)
	return e1, e2
end

local BOX_SIGNS = {
	Vector3.new(-1, -1, -1), Vector3.new(1, -1, -1), Vector3.new(-1, 1, -1), Vector3.new(1, 1, -1),
	Vector3.new(-1, -1, 1), Vector3.new(1, -1, 1), Vector3.new(-1, 1, 1), Vector3.new(1, 1, 1),
}

-- Appends silhouette points to `out` starting after index `n`; returns the new count.
local function appendSilhouettePoints(c: Caster, lightDir: Vec3, out: { Vec3 }, n: number): number
	local cf = c.cf
	local kind = c.kind

	if kind == "Box" then
		local hx, hy, hz = c.half.X, c.half.Y, c.half.Z
		for i = 1, 8 do
			local s = BOX_SIGNS[i]
			n += 1
			out[n] = cf:PointToWorldSpace(Vector3.new(s.X * hx, s.Y * hy, s.Z * hz))
		end
	elseif kind == "Points" then
		for _, v in ipairs(c.verts) do
			n += 1
			out[n] = v
		end
	elseif kind == "Ellipsoid" then
		-- Ellipsoid silhouette: local points A*s where s is perpendicular to A^-1 * L (exact)
		local a = c.half
		local lLocal = cf:VectorToObjectSpace(lightDir)
		local w = Vector3.new(lLocal.X / a.X, lLocal.Y / a.Y, lLocal.Z / a.Z).Unit
		local s1, s2 = perpendicularBasis(w)
		local trig = getTrig(CONFIG.CurveSegments)
		for i = 1, CONFIG.CurveSegments do
			local s = s1 * trig.cos[i] + s2 * trig.sin[i]
			n += 1
			out[n] = cf:PointToWorldSpace(Vector3.new(a.X * s.X, a.Y * s.Y, a.Z * s.Z))
		end
	elseif kind == "RoundBox" then
		-- Box with spherical corners: each corner sphere contributes its light-facing silhouette ring
		local r = c.radius
		local hx = math.max(c.half.X - r, 0)
		local hy = math.max(c.half.Y - r, 0)
		local hz = math.max(c.half.Z - r, 0)
		local e1, e2 = perpendicularBasis(lightDir)
		local segs = CONFIG.RoundCornerSegments
		local trig = getTrig(segs)
		for i = 1, 8 do
			local s = BOX_SIGNS[i]
			local corner = cf:PointToWorldSpace(Vector3.new(s.X * hx, s.Y * hy, s.Z * hz))
			for j = 1, segs do
				n += 1
				out[n] = corner + (e1 * trig.cos[j] + e2 * trig.sin[j]) * r
			end
		end
	elseif kind == "RoundCyl" then
		-- Cylinder with rounded rim: 3 rings per end trace the rounded edge, so the oval stays smooth
		local axis = if c.axisX then cf.RightVector else cf.UpVector
		local ra = if c.axisX then cf.UpVector else cf.RightVector
		local rb = cf.LookVector
		local center = cf.Position
		local r, h, rho = c.radius, c.halfLen, math.min(c.rounding, c.radius, c.halfLen)
		local segs = CONFIG.CylinderSegments
		local trig = getTrig(segs)

		local rings = if rho > 0.01 then 3 else 1
		for side = -1, 1, 2 do
			for ring = 1, rings do
				local ang = if rings == 1 then 0 else (ring - 1) / (rings - 1) * (math.pi * 0.5)
				local ringR = r - rho + rho * math.cos(ang)
				local ringH = h - rho + rho * math.sin(ang)
				local ringCenter = center + axis * (ringH * side)
				for j = 1, segs do
					n += 1
					out[n] = ringCenter + (ra * trig.cos[j] + rb * trig.sin[j]) * ringR
				end
			end
		end
	end
	return n
end

local function isAccessoryPart(part: BasePart): boolean
	local parent = part.Parent
	return parent ~= nil and parent:IsA("Accessory")
end

local function buildCaster(part: BasePart, isCharacter: boolean): Caster
	local cf = part.CFrame
	local size = part.Size
	local mesh = part:FindFirstChildOfClass("SpecialMesh")
	local meshType = if mesh then mesh.MeshType else nil
	local scale = if mesh then mesh.Scale else Vector3.one
	if mesh and mesh.Offset ~= Vector3.zero then
		cf = cf * CFrame.new(mesh.Offset)
	end

	local caster: Caster = {
		kind = "Box",
		cf = cf,
		half = size * 0.5,
		verts = nil,
		radius = 0,
		axisX = false,
		halfLen = 0,
		rounding = 0,
		part = part,
	}

	-- 1. Balls / sphere meshes -> ellipsoid (exact elliptical shadow)
	if (part:IsA("Part") and part.Shape == Enum.PartType.Ball) then
		local r = math.min(size.X, size.Y, size.Z) * 0.5
		caster.kind = "Ellipsoid"
		caster.half = Vector3.new(r, r, r)
		return caster
	end
	if meshType == Enum.MeshType.Sphere then
		caster.kind = "Ellipsoid"
		caster.half = size * scale * 0.5
		return caster
	end

	-- 2. Classic heads -> vertical rounded cylinder (the familiar round head blob)
	if meshType == Enum.MeshType.Head then
		local s = size * scale
		caster.kind = "RoundCyl"
		caster.axisX = false
		caster.radius = math.min(s.X, s.Z) * 0.5
		caster.halfLen = s.Y * 0.5
		caster.rounding = caster.radius * 0.45
		return caster
	end

	-- 3. Cylinders (Part cylinders run along X; SpecialMesh cylinders run along Y)
	if part:IsA("Part") and part.Shape == Enum.PartType.Cylinder then
		caster.kind = "RoundCyl"
		caster.axisX = true
		caster.radius = math.min(size.Y, size.Z) * 0.5
		caster.halfLen = size.X * 0.5
		return caster
	end
	if meshType == Enum.MeshType.Cylinder then
		local s = size * scale
		caster.kind = "RoundCyl"
		caster.axisX = false
		caster.radius = math.min(s.X, s.Z) * 0.5
		caster.halfLen = s.Y * 0.5
		return caster
	end

	-- 4. Wedges -> exact 6 corners
	if part:IsA("WedgePart") or (part:IsA("Part") and part.Shape == Enum.PartType.Wedge) then
		local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
		caster.kind = "Points"
		caster.verts = {
			cf:PointToWorldSpace(Vector3.new(-hx, -hy, -hz)),
			cf:PointToWorldSpace(Vector3.new(hx, -hy, -hz)),
			cf:PointToWorldSpace(Vector3.new(-hx, -hy, hz)),
			cf:PointToWorldSpace(Vector3.new(hx, -hy, hz)),
			cf:PointToWorldSpace(Vector3.new(-hx, hy, hz)),
			cf:PointToWorldSpace(Vector3.new(hx, hy, hz)),
		}
		return caster
	end

	-- 5. Character heads, hair, and hats -> smooth ellipsoids
	local isAccessory = isAccessoryPart(part)
	if isAccessory or (isCharacter and part.Name == "Head") then
		local s = size
		if meshType == Enum.MeshType.FileMesh then
			-- FileMesh scale is relative to the mesh's own units, so stay near the handle size
			s = Vector3.new(math.clamp(s.X, 0.3, 2.6), math.clamp(s.Y, 0.3, 2.6), math.clamp(s.Z, 0.3, 2.6))
		end
		local shrink = if isAccessory then CONFIG.AccessoryShrink else 0.95
		caster.kind = "Ellipsoid"
		caster.half = s * (0.5 * shrink)
		return caster
	end

	-- 6. Brick meshes keep their scale
	if meshType == Enum.MeshType.Brick then
		caster.half = size * scale * 0.5
	end

	-- 7. MeshParts / unions / file meshes -> rounded boxes; character limbs -> softly rounded boxes
	local half = caster.half
	local minHalf = math.min(half.X, half.Y, half.Z)
	if part:IsA("MeshPart") or part:IsA("UnionOperation") or meshType == Enum.MeshType.FileMesh then
		caster.kind = "RoundBox"
		caster.radius = minHalf * CONFIG.MeshRoundingFraction
		if isCharacter then
			caster.radius = math.max(caster.radius, math.min(CONFIG.CharacterLimbRounding, minHalf))
		end
	elseif isCharacter and CONFIG.CharacterLimbRounding > 0 then
		caster.kind = "RoundBox"
		caster.radius = math.min(CONFIG.CharacterLimbRounding, minHalf)
	end
	return caster
end

-- ============================================================================
-- EVENT-DRIVEN SCENE CACHE
-- ============================================================================
local characterModels: { [Model]: boolean } = {}
local mapCasterPartsSet: { [BasePart]: boolean } = {}

local function shouldPartCastMapShadow(part: BasePart): boolean
	if part == Workspace.Terrain or part:IsDescendantOf(shadowContainer) then
		return false
	end
	if part.Transparency >= 0.9 then
		return false
	end
	local s = part.Size
	local isGiantBaseplate = (s.X > CONFIG.MaxCasterPartSize or s.Z > CONFIG.MaxCasterPartSize) and s.Y < 15
	if isGiantBaseplate then
		return false
	end
	if s.X < CONFIG.MinCasterPartSize and s.Y < CONFIG.MinCasterPartSize and s.Z < CONFIG.MinCasterPartSize then
		return false
	end
	return true
end

local function registerInstance(inst: Instance)
	if inst:IsDescendantOf(shadowContainer) then
		return
	end
	if inst:IsA("Humanoid") and inst.Parent and inst.Parent:IsA("Model") then
		local charModel = inst.Parent :: Model
		characterModels[charModel] = true
		for _, desc in ipairs(charModel:GetDescendants()) do
			if desc:IsA("BasePart") then
				mapCasterPartsSet[desc] = nil
				if CONFIG.ForceDisableNativeShadows and desc.CastShadow then
					desc.CastShadow = false
				end
			end
		end
	elseif inst:IsA("BasePart") then
		if CONFIG.ForceDisableNativeShadows and inst.CastShadow then
			inst.CastShadow = false
		end
		local anc = inst.Parent
		while anc and anc ~= Workspace do
			if anc:IsA("Model") and (characterModels[anc] or anc:FindFirstChildOfClass("Humanoid")) then
				characterModels[anc] = true
				return
			end
			anc = anc.Parent
		end
		if shouldPartCastMapShadow(inst) then
			mapCasterPartsSet[inst] = true
		end
	end
end

local mapEntries: { [BasePart]: any } = {}

local function unregisterInstance(inst: Instance)
	if inst:IsA("Model") then
		characterModels[inst] = nil
	elseif inst:IsA("BasePart") then
		mapCasterPartsSet[inst] = nil
		mapEntries[inst] = nil
	end
end

for _, inst in ipairs(Workspace:GetDescendants()) do
	registerInstance(inst)
end

Workspace.DescendantAdded:Connect(registerInstance)
Workspace.DescendantRemoving:Connect(unregisterInstance)

-- ============================================================================
-- RAYCASTING HELPERS
-- ============================================================================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local baseFilterList: { Instance } = { shadowContainer }

local function setRayFilter(extra: Instance)
	local list = table.clone(baseFilterList)
	table.insert(list, extra)
	rayParams.FilterDescendantsInstances = list
end

-- Raycast that passes straight through invisible parts so shadows never land on them
local function castReceiverRay(origin: Vec3, direction: Vec3): RaycastResult?
	for _ = 1, 4 do
		local hit = Workspace:Raycast(origin, direction, rayParams)
		if not hit then
			return nil
		end
		local inst = hit.Instance
		if inst:IsA("BasePart") and inst.Transparency >= 0.95 then
			rayParams:AddToFilter(inst)
		else
			return hit
		end
	end
	return nil
end

-- Finds the surfaces a group of probe points throws shadow onto (plus cliff spill-over surfaces)
local function discoverReceiverPlanes(probes: { Vec3 }, probeCount: number, lightDir: Vec3, planesOut: { [string]: ReceiverPlane })
	local rayDir = lightDir * CONFIG.MaxShadowDistance
	local horizLight = Vector3.new(lightDir.X, 0, lightDir.Z)
	local spillDir = if horizLight.Magnitude > 0.05 then horizLight.Unit * 2.2 else nil

	for i = 1, probeCount do
		local hit = castReceiverRay(probes[i], rayDir)
		if hit and hit.Instance:IsA("BasePart") then
			local hitPart = hit.Instance :: BasePart
			local plane = extractReceiverPlane(hitPart, hit.Normal, hit.Position)
			if plane and not planesOut[plane.baseKey] then
				planesOut[plane.baseKey] = plane
			end

			-- Cliff / ledge spill: shadows continue past the edge and bend down onto the surface below
			if spillDir and math.abs(hit.Normal.Y) > 0.7 then
				local cliffHit = castReceiverRay(hit.Position + spillDir + Vector3.new(0, 0.3, 0), rayDir)
				if cliffHit and cliffHit.Instance ~= hitPart and cliffHit.Instance:IsA("BasePart") then
					local cliffPlane = extractReceiverPlane(cliffHit.Instance :: BasePart, cliffHit.Normal, cliffHit.Position)
					if cliffPlane and not planesOut[cliffPlane.baseKey] then
						planesOut[cliffPlane.baseKey] = cliffPlane
					end
				end
			end
		end
	end
end

-- One wall-obstruction test per (caster group, plane). Returns: 0 = clear, 1 = clip by half-plane, 2 = hidden
local function computeObstruction(anchor: Vec3, lightDir: Vec3, plane: ReceiverPlane): (number, Vec2?, Vec2?)
	local nDotL = plane.normal:Dot(lightDir)
	if nDotL >= -0.025 then
		return 2 -- Surface faces away from the light: it can't receive a shadow
	end
	local t = (plane.origin - anchor):Dot(plane.normal) / nDotL
	if t <= 0.2 then
		return 0
	end
	local target = anchor + lightDir * t + plane.normal * 0.04
	local toReceiver = target - anchor
	local hit = Workspace:Raycast(anchor, toReceiver, rayParams)
	if not hit or hit.Instance == plane.part then
		return 0
	end
	if (hit.Position - anchor).Magnitude >= toReceiver.Magnitude - CONFIG.WallObstructionTolerance then
		return 0
	end
	-- Stacked surfaces (steps, ledges, tables) hide that part of the shadow anyway: don't clip
	if math.abs(hit.Normal:Dot(plane.normal)) > 0.7 then
		return 0
	end

	local relWall = hit.Position - plane.origin
	local wallPt2D = Vector2.new(relWall:Dot(plane.tangentU), relWall:Dot(plane.tangentV))
	local wallNorm2D = Vector2.new(hit.Normal:Dot(plane.tangentU), hit.Normal:Dot(plane.tangentV))
	if wallNorm2D.Magnitude < 1e-3 then
		return 2
	end
	wallNorm2D = wallNorm2D.Unit
	local anchorRel = anchor - plane.origin
	local anchor2D = Vector2.new(anchorRel:Dot(plane.tangentU), anchorRel:Dot(plane.tangentV))
	if (anchor2D - wallPt2D):Dot(wallNorm2D) < 0 then
		wallNorm2D = -wallNorm2D
	end
	return 1, wallPt2D, wallNorm2D
end

-- ============================================================================
-- SHADOW PROJECTION
-- ============================================================================
local projScratch: { Vec2 } = {}

-- Projects a caster's silhouette points onto a plane, returning the clipped shadow polygon (or nil)
local function projectSilhouette(points: { Vec3 }, first: number, last: number, center: Vec3, lightDir: Vec3, plane: ReceiverPlane): { Vec2 }?
	local normal = plane.normal
	local nDotL = normal:Dot(lightDir)
	if nDotL >= -0.025 then
		return nil
	end

	local origin = plane.origin
	local tc = (origin - center):Dot(normal) / nDotL
	if tc < -1.5 or tc > CONFIG.MaxShadowDistance then
		return nil
	end

	local tu, tv = plane.tangentU, plane.tangentV
	local maxT = CONFIG.MaxShadowDistance
	local count = 0
	for i = first, last do
		local p = points[i]
		local t = (origin - p):Dot(normal) / nDotL
		if t <= maxT then
			-- Points under the surface use their footprint so the shadow stays attached to the base
			local rel = (if t > 0 then p + lightDir * t else p) - origin
			count += 1
			projScratch[count] = Vector2.new(rel:Dot(tu), rel:Dot(tv))
		end
	end

	local hull = computeConvexHull2D(projScratch, count)
	if #hull < 3 then
		return nil
	end
	local clipped = clipPolygonToRect2D(hull, plane.halfU, plane.halfV)
	if #clipped < 3 then
		return nil
	end
	return clipped
end

local silhouettePoints: { Vec3 } = {}
local casterRanges: { number } = {}   -- first/last index pairs into silhouettePoints
local probeScratch: { Vec3 } = {}

-- Computes shadow draws for a group of casters that share one anchor (a character, or one map part)
local function computeGroupDraws(casters: { Caster }, anchor: Vec3, lightDir: Vec3, probes: { Vec3 }, probeCount: number, withCache: boolean): ({ Draw }, { [string]: ReceiverPlane })
	local planes: { [string]: ReceiverPlane } = {}
	discoverReceiverPlanes(probes, probeCount, lightDir, planes)

	-- Build every silhouette once per caster (independent of the receiving plane)
	local n = 0
	for ci, caster in ipairs(casters) do
		local first = n + 1
		n = appendSilhouettePoints(caster, lightDir, silhouettePoints, n)
		casterRanges[ci * 2 - 1] = first
		casterRanges[ci * 2] = n
	end

	local draws: { Draw } = {}
	for _, plane in pairs(planes) do
		local status, wallPt, wallNorm = computeObstruction(anchor, lightDir, plane)
		if status ~= 2 then
			for ci, caster in ipairs(casters) do
				if caster.part ~= plane.part then
					local poly = projectSilhouette(silhouettePoints, casterRanges[ci * 2 - 1], casterRanges[ci * 2], caster.cf.Position, lightDir, plane)
					if poly and status == 1 then
						poly = clipPolygonHalfPlane2D(poly, wallPt, wallNorm)
						if #poly < 3 then
							poly = nil
						end
					end
					if poly then
						table.insert(draws, {
							plane = plane,
							poly = poly,
							tileCache = if withCache then {} else nil,
						})
					end
				end
			end
		end
	end
	return draws, planes
end

-- ============================================================================
-- MAP SHADOW CACHE (REBUILT ONLY WHEN SOMETHING CHANGES)
-- ============================================================================
local lightVersion = 0
local cachedLightDir: Vec3? = nil
local nextEntryId = 0
local selectedByDistance: { BasePart } = {}
local selectedById: { BasePart } = {}
local lastMapSortTime = -math.huge

local function getEntry(part: BasePart)
	local e = mapEntries[part]
	if not e then
		nextEntryId += 1
		e = { id = nextEntryId, part = part, cf = nil, size = nil, lightVersion = -1, draws = nil, receivers = {} }
		mapEntries[part] = e
	end
	return e
end

local function isEntryValid(e): boolean
	if e.lightVersion ~= lightVersion then
		return false
	end
	local part = e.part
	if part.CFrame ~= e.cf or part.Size ~= e.size then
		return false
	end
	for _, r in ipairs(e.receivers) do
		if r.part.Parent == nil or r.part.CFrame ~= r.cf or r.part.Size ~= r.size then
			return false
		end
	end
	return true
end

local function rebuildEntry(e, lightDir: Vec3)
	local part = e.part
	e.cf = part.CFrame
	e.size = part.Size
	e.lightVersion = lightVersion

	local caster = buildCaster(part, false)

	-- Fire receiver rays from the center and every corner so big parts reach every surface they shade
	local cf, half = part.CFrame, part.Size * 0.5
	probeScratch[1] = cf.Position
	for i = 1, 8 do
		local s = BOX_SIGNS[i]
		probeScratch[i + 1] = cf:PointToWorldSpace(Vector3.new(s.X * half.X, s.Y * half.Y, s.Z * half.Z))
	end

	setRayFilter(part)
	local draws, planes = computeGroupDraws({ caster }, cf.Position, lightDir, probeScratch, 9, true)

	local receivers = {}
	local seen = {}
	for _, plane in pairs(planes) do
		local rp = plane.part
		if not seen[rp] then
			seen[rp] = true
			table.insert(receivers, { part = rp, cf = rp.CFrame, size = rp.Size })
		end
	end
	e.draws = draws
	e.receivers = receivers
end

local function refreshMapSelection(focusPos: Vec3)
	local candidates = {}
	local maxDist = CONFIG.MaxRenderDistance
	for part in pairs(mapCasterPartsSet) do
		if part.Parent and part.Transparency < 0.9 then
			local dist = (part.Position - focusPos).Magnitude
			if dist <= maxDist then
				table.insert(candidates, { part = part, dist = dist })
			end
		else
			mapCasterPartsSet[part] = nil
		end
	end
	table.sort(candidates, function(a, b)
		return a.dist < b.dist
	end)

	table.clear(selectedByDistance)
	table.clear(selectedById)
	for i = 1, math.min(#candidates, CONFIG.MaxMapCasters) do
		local part = candidates[i].part
		getEntry(part)
		selectedByDistance[i] = part
		selectedById[i] = part
	end
	-- A stable draw order means static frames never shuffle (and never get rewritten)
	table.sort(selectedById, function(a, b)
		return mapEntries[a].id < mapEntries[b].id
	end)

	-- Rays ignore every character (map shadows are cached, so they must never land on moving bodies)
	table.clear(baseFilterList)
	baseFilterList[1] = shadowContainer
	for model in pairs(characterModels) do
		if model.Parent then
			table.insert(baseFilterList, model)
		else
			characterModels[model] = nil
		end
	end
end

-- ============================================================================
-- CHARACTER SHADOWS (DYNAMIC, EVERY FRAME)
-- ============================================================================
local characterState: { [Model]: { frame: number, draws: { Draw } } } = {}

local CHARACTER_PROBE_OFFSETS = {
	Vector3.new(0, 0, 0),
	Vector3.new(2.2, 0, 0),
	Vector3.new(-2.2, 0, 0),
	Vector3.new(0, 0, 2.2),
	Vector3.new(0, 0, -2.2),
	Vector3.new(0, 1.5, 0),
	Vector3.new(0, -2.5, 0),
}

local function collectCharacterCasters(model: Model): { Caster }
	local casters: { Caster } = {}
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") then
			if child.Transparency < 0.95 and child.Name ~= "HumanoidRootPart" then
				if CONFIG.ForceDisableNativeShadows and child.CastShadow then
					child.CastShadow = false
				end
				table.insert(casters, buildCaster(child, true))
			end
		elseif child:IsA("Accessory") or child:IsA("Tool") then
			for _, desc in ipairs(child:GetDescendants()) do
				if desc:IsA("BasePart") and desc.Transparency < 0.95 then
					if CONFIG.ForceDisableNativeShadows and desc.CastShadow then
						desc.CastShadow = false
					end
					table.insert(casters, buildCaster(desc, true))
				end
			end
		end
	end
	return casters
end

-- ============================================================================
-- MAIN PER-FRAME PIPELINE
-- ============================================================================
local frameIndex = 0

RunService.RenderStepped:Connect(function()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	frameIndex += 1

	if CONFIG.ForceDisableNativeShadows and Lighting.GlobalShadows then
		Lighting.GlobalShadows = false
	end

	-- Light direction (sun by day, moon by night, never too flat)
	local sunDir = Lighting:GetSunDirection()
	if sunDir.Y < -0.05 then
		sunDir = Lighting:GetMoonDirection()
	end
	if sunDir.Y < 0.15 then
		sunDir = Vector3.new(sunDir.X, 0.32, sunDir.Z).Unit
	end
	local newLightDir = -sunDir.Unit
	if not cachedLightDir
		or math.deg(math.acos(math.clamp(cachedLightDir:Dot(newLightDir), -1, 1))) > CONFIG.LightRebuildAngle
	then
		cachedLightDir = newLightDir
		lightVersion += 1
	end
	local lightDir = cachedLightDir :: Vec3

	table.clear(frameTilesByKey)

	-- Center everything on the local character so turning the camera never drops shadows
	local localPlayer = Players.LocalPlayer
	local focusPos = camera.CFrame.Position
	local character = localPlayer and localPlayer.Character
	if character and character.PrimaryPart then
		focusPos = character.PrimaryPart.Position
	end
	currentFocusPos = focusPos

	local now = os.clock()
	if now - lastMapSortTime >= CONFIG.MapRefreshInterval then
		lastMapSortTime = now
		refreshMapSelection(focusPos)
	end

	-- 1. Static map shadows: rebuild a few stale ones (nearest first), draw all from cache
	if CONFIG.IncludeMapParts then
		local budget = CONFIG.MapRebuildBudget
		for _, part in ipairs(selectedByDistance) do
			if budget <= 0 then
				break
			end
			local e = mapEntries[part]
			if e and part.Parent and not isEntryValid(e) then
				rebuildEntry(e, lightDir)
				budget -= 1
			end
		end

		for _, part in ipairs(selectedById) do
			local e = mapEntries[part]
			if e and e.draws and part.Parent then
				for _, draw in ipairs(e.draws) do
					emitDraw(draw)
				end
			end
		end
	end

	-- 2. Dynamic character shadows (drawn after map shadows so the static frames keep their slots)
	for model in pairs(characterModels) do
		if model.Parent then
			local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
			if root and root:IsA("BasePart") then
				local dist = (root.Position - focusPos).Magnitude
				if dist <= CONFIG.MaxRenderDistance then
					local state = characterState[model]
					local reuse = state ~= nil
						and dist > CONFIG.FarCharacterDistance
						and frameIndex - state.frame < CONFIG.FarCharacterUpdateEvery

					if not reuse then
						local casters = collectCharacterCasters(model)
						local draws = {}
						if #casters > 0 then
							local rootPos = root.Position
							for i, offset in ipairs(CHARACTER_PROBE_OFFSETS) do
								probeScratch[i] = rootPos + offset
							end
							setRayFilter(model)
							draws = computeGroupDraws(casters, rootPos, lightDir, probeScratch, #CHARACTER_PROBE_OFFSETS, false)
						end
						state = { frame = frameIndex, draws = draws }
						characterState[model] = state
					end

					for _, draw in ipairs(state.draws) do
						emitDraw(draw)
					end
				end
			end
		else
			characterModels[model] = nil
			characterState[model] = nil
		end
	end

	finalizeCanvasSlotsForFrame()
end)

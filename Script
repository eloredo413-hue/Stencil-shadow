-- ============================================================================
-- RETAINED CANVAS SLOTS: every receiver tile has a STATIC layer (map shadows,
-- drawn once and left alone) and a DYNAMIC layer (characters, redrawn per frame)
-- inside ONE CanvasGroup, so overlapping shadows never double-darken.
-- ============================================================================
do
	local canvasSlots = {}
	local tileRecs = {}
	local tileRecList = {}
	local currentFrameId = 1
	local dirtyQueue = {}
	local dirtyHead = 1
	local dynSlotsThisFrame = {}
	local dynSlotsPrev = {}

	local function newPool(holder, isDynamic)
		return { holder = holder, dynamic = (isDynamic == true), rects = {}, discs = {}, nRect = 0, nDisc = 0, prevRect = 0, prevDisc = 0 }
	end

	local function createPrimitive(pool, isDisc)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BackgroundColor3 = CONFIG.ShadowColor
		f.BackgroundTransparency = 0
		f.BorderSizePixel = 0
		f.Visible = false
		if isDisc then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = f
		end
		f.Parent = pool.holder
		return { frame = f, x = -1e9, y = -1e9, w = -1, h = -1, rot = -1e9, shown = false }
	end

	-- Only writes properties that actually changed (GUI property writes are costly).
	function setPrimitive(rec, x, y, w, h, rot)
		if not rec.shown then
			rec.shown = true
			rec.frame.Visible = true
		end
		if math.abs(rec.x - x) > 0.05 or math.abs(rec.y - y) > 0.05 then
			rec.x, rec.y = x, y
			rec.frame.Position = UDim2.new(0, x, 0, y)
		end
		if math.abs(rec.w - w) > 0.05 or math.abs(rec.h - h) > 0.05 then
			rec.w, rec.h = w, h
			rec.frame.Size = UDim2.new(0, w, 0, h)
		end
		if math.abs(rec.rot - rot) > 0.02 then
			rec.rot = rot
			rec.frame.Rotation = rot
		end
	end

	local function hidePrimitive(rec)
		if rec.shown then
			rec.shown = false
			rec.frame.Visible = false
		end
	end

	function acquireRect(pool)
		local idx = pool.nRect + 1
		pool.nRect = idx
		local rec = pool.rects[idx]
		if not rec then
			rec = createPrimitive(pool, false)
			pool.rects[idx] = rec
		end
		return rec
	end

	function acquireDisc(pool)
		local idx = pool.nDisc + 1
		pool.nDisc = idx
		local rec = pool.discs[idx]
		if not rec then
			rec = createPrimitive(pool, true)
			pool.discs[idx] = rec
		end
		return rec
	end

	local function beginPool(pool)
		pool.nRect = 0
		pool.nDisc = 0
	end

	local function endPool(pool)
		for r = pool.nRect + 1, pool.prevRect do
			hidePrimitive(pool.rects[r])
		end
		for d = pool.nDisc + 1, pool.prevDisc do
			hidePrimitive(pool.discs[d])
		end
		pool.prevRect = pool.nRect
		pool.prevDisc = pool.nDisc
	end

	local function newHolder(parent, name)
		local f = Instance.new("Frame")
		f.Name = name
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.Size = UDim2.new(1, 0, 1, 0)
		f.Parent = parent
		return f
	end

	local function createCanvasSlot(slotIndex)
		local part = Instance.new("Part")
		part.Name = "StencilSurface_" .. tostring(slotIndex)
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Massless = true
		part.Transparency = 1
		part.Size = Vector3.new(4, 4, 0.01)
		part.CFrame = CFrame.new(0, -5000, 0)

		local sgui = Instance.new("SurfaceGui")
		sgui.Name = "ShadowSurfaceGui"
		sgui.Face = Enum.NormalId.Front
		sgui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		sgui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sgui.CanvasSize = Vector2.new(64, 64)
		sgui.LightInfluence = 0
		sgui.Brightness = 1
		sgui.ClipsDescendants = true
		sgui.ResetOnSpawn = false
		sgui.ZOffset = 2
		sgui.Enabled = false
		-- Some Roblox versions cull SurfaceGuis beyond a fixed distance; lift that.
		pcall(function()
			sgui.MaxDistance = 100000
		end)
		sgui.Adornee = part
		sgui.Parent = part

		local cg = Instance.new("CanvasGroup")
		cg.Name = "UnifiedStencilCanvas"
		cg.BackgroundTransparency = 1
		cg.BorderSizePixel = 0
		cg.Size = UDim2.new(1, 0, 1, 0)
		cg.GroupColor3 = Color3.new(1, 1, 1)
		cg.GroupTransparency = currentGroupTransparency
		cg.Parent = sgui

		local statHolder = newHolder(cg, "Static")
		local dynHolder = newHolder(cg, "Dynamic")
		part.Parent = shadowContainer

		return {
			carrierPart = part,
			surfaceGui = sgui,
			canvasGroup = cg,
			stat = newPool(statHolder),
			dyn = newPool(dynHolder, true),
			rec = nil,
			enabled = false,
			dynFrame = -1,
			gt = currentGroupTransparency,
			lastSize = nil,
			lastCF = nil,
			lastCanvas = nil,
		}
	end

	local totalCanvasPx = 0

	-- A tile's canvas only renders while it is bound AND (probably) on screen.
	local function syncSlotEnabled(slot)
		local rec = slot.rec
		local want = rec ~= nil and rec.onScreen ~= false
		if slot.enabled ~= want then
			slot.enabled = want
			slot.surfaceGui.Enabled = want
		end
	end

	local function parkSlot(slot)
		slot.rec = nil
		syncSlotEnabled(slot)
	end

	local function releaseTileSlot(rec)
		local slot = rec.slot
		if slot then
			totalCanvasPx = totalCanvasPx - (rec.canvasPx or 0)
			rec.canvasPx = 0
			parkSlot(slot)
			rec.slot = nil
			rec.dirty = true
			rec.appliedPps = nil
		end
	end

	-- ----------------------------------------------------------------------------
	-- Tile records (persistent, one per receiver tile)
	-- ----------------------------------------------------------------------------
	local function samePlaneGeometry(a, b)
		return (a.origin - b.origin).Magnitude < 0.03
			and a.normal:Dot(b.normal) > 0.99999
			and a.tangentU:Dot(b.tangentU) > 0.99999
			and math.abs(a.halfU - b.halfU) < 0.03
			and math.abs(a.halfV - b.halfV) < 0.03
	end

	local function computeRecBounds(rec)
		local plane = rec.plane
		local S = CONFIG.SharedTileSize
		local uMin, uMax, vMin, vMax
		if plane.isTiled then
			uMin = math.max(-plane.halfU, rec.tx * S - S * 0.5)
			uMax = math.min(plane.halfU, rec.tx * S + S * 0.5)
			vMin = math.max(-plane.halfV, rec.ty * S - S * 0.5)
			vMax = math.min(plane.halfV, rec.ty * S + S * 0.5)
			if uMax <= uMin + 0.2 or vMax <= vMin + 0.2 then
				return false
			end
		else
			uMin, uMax, vMin, vMax = -plane.halfU, plane.halfU, -plane.halfV, plane.halfV
		end
		rec.centerU = (uMin + uMax) * 0.5
		rec.centerV = (vMin + vMax) * 0.5
		rec.halfU = (uMax - uMin) * 0.5
		rec.halfV = (vMax - vMin) * 0.5
		rec.origin = plane.origin + plane.tangentU * rec.centerU + plane.tangentV * rec.centerV
		rec.radius = math.sqrt(rec.halfU * rec.halfU + rec.halfV * rec.halfV)
		rec.tile.isCircularDisk = plane.isCircularDisk
		rec.tile.diskRadius = plane.halfU
		return true
	end

	local function enqueueTile(rec)
		if not rec.queued then
			rec.queued = true
			dirtyQueue[#dirtyQueue + 1] = rec
		end
	end

	local function markTileDirty(rec)
		rec.dirty = true
		if rec.wanted then
			enqueueTile(rec)
		end
	end

	local function getTileRec(plane, tx, ty)
		local key = plane.baseKey
		if plane.isTiled then
			key = key .. "_" .. tostring(tx) .. "_" .. tostring(ty)
		end
		local rec = tileRecs[key]
		if rec == false then
			return nil
		end
		if rec then
			if rec.plane ~= plane and not samePlaneGeometry(rec.plane, plane) then
				-- The receiver moved or was resized: everything drawn on it is stale.
				rec.plane = plane
				computeRecBounds(rec)
				for part in pairs(rec.contrib) do
					local st = casterStates[part]
					if st then
						st.epoch = -1
					end
				end
				markTileDirty(rec)
			end
			return rec
		end
		rec = {
			key = key,
			plane = plane,
			tx = tx,
			ty = ty,
			contrib = {},
			nContrib = 0,
			dirty = true,
			queued = false,
			slot = nil,
			wanted = false,
			dist = math.huge,
			lastDynFrame = -1000,
			prio = math.huge,
			onScreen = true,
			canvasPx = 0,
			lodPps = nil,
			appliedPps = nil,
			tile = {},
		}
		if not computeRecBounds(rec) then
			tileRecs[key] = false
			return nil
		end
		tileRecs[key] = rec
		tileRecList[#tileRecList + 1] = rec
		return rec
	end

	-- ----------------------------------------------------------------------------
	-- Slot acquisition (free slot, lazily created slot, or evict the least useful)
	-- ----------------------------------------------------------------------------
	local function acquireSlotFor(rec, priorityDist)
		for i = 1, #canvasSlots do
			if canvasSlots[i].rec == nil then
				return canvasSlots[i]
			end
		end
		if #canvasSlots < CONFIG.MaxActiveCanvasSlots then
			local slot = createCanvasSlot(#canvasSlots + 1)
			canvasSlots[#canvasSlots + 1] = slot
			return slot
		end
		local victim, victimScore = nil, -1
		for i = 1, #canvasSlots do
			local slot = canvasSlots[i]
			local r = slot.rec
			if r.lastDynFrame < currentFrameId - 2 then
				local score = r.wanted and (r.prio or r.dist) or 1e9
				if score > victimScore then
					victim, victimScore = slot, score
				end
			end
		end
		if not victim then
			return nil
		end
		if victim.rec.wanted and victimScore <= priorityDist then
			return nil
		end
		releaseTileSlot(victim.rec)
		return victim
	end

	local function ensureTileBound(rec, priorityDist)
		local slot = rec.slot
		if slot then
			return slot
		end
		slot = acquireSlotFor(rec, priorityDist)
		if not slot then
			return nil
		end
		slot.rec = rec
		rec.slot = slot
		rec.dirty = true
		rec.appliedPps = nil
		if slot.gt ~= currentGroupTransparency then
			slot.gt = currentGroupTransparency
			slot.canvasGroup.GroupTransparency = currentGroupTransparency
		end
		beginPool(slot.stat)
		endPool(slot.stat)
		beginPool(slot.dyn)
		endPool(slot.dyn)
		return slot
	end

	-- ----------------------------------------------------------------------------
	-- Resolution (LOD) and geometry of a bound tile
	-- ----------------------------------------------------------------------------
	local LOD_FACTOR = 0.62

	local function chooseTilePps(rec, dist)
		local top = CONFIG.PixelsPerStud * math.min(lodStep, lodBudgetStep)
		local raw = top * CONFIG.LodNearDistance / math.max(dist, CONFIG.LodNearDistance)
		raw = math.max(raw, CONFIG.MinPixelsPerStud)
		local cur = rec.lodPps
		if cur and raw >= cur * 0.72 and raw <= cur * 1.45 and cur <= top * 1.001 then
			return cur
		end
		local chosen = top
		while chosen > raw * 1.08 and chosen * LOD_FACTOR >= CONFIG.MinPixelsPerStud do
			chosen = chosen * LOD_FACTOR
		end
		chosen = math.max(chosen, CONFIG.MinPixelsPerStud)
		rec.lodPps = chosen
		return chosen
	end

	local function applyTileGeometry(rec, pps)
		local slot = rec.slot
		local plane = rec.plane
		local w2, h2 = rec.halfU * 2, rec.halfV * 2
		local rawW = math.clamp(math.ceil(w2 * pps), 16, CONFIG.MaxCanvasPixels)
		local rawH = math.clamp(math.ceil(h2 * pps), 16, CONFIG.MaxCanvasPixels)

		-- Depth precision drops with distance: lift far shadows a little more.
		local offset = CONFIG.SurfaceOffset + math.min(math.floor(math.max(rec.dist, 0) / 60), 12) * 0.015
		local size = Vector3.new(w2, h2, 0.01)
		local cf = CFrame.fromMatrix(
			rec.origin + plane.normal * offset,
			-plane.tangentU,
			plane.tangentV,
			-plane.normal
		)
		local canvas = Vector2.new(rawW, rawH)

		if slot.lastSize ~= size then
			slot.lastSize = size
			slot.carrierPart.Size = size
		end
		if slot.lastCF ~= cf then
			slot.lastCF = cf
			slot.carrierPart.CFrame = cf
		end
		if slot.lastCanvas ~= canvas then
			slot.lastCanvas = canvas
			slot.surfaceGui.CanvasSize = canvas
			rec.dirty = true
		end
		local px = rawW * rawH
		totalCanvasPx = totalCanvasPx + px - (rec.canvasPx or 0)
		rec.canvasPx = px
		syncSlotEnabled(slot)

		local tile = rec.tile
		tile.centerU = rec.centerU
		tile.centerV = rec.centerV
		tile.halfU = rec.halfU
		tile.halfV = rec.halfV
		tile.scaleX = rawW / w2
		tile.scaleY = rawH / h2
		tile.pps = pps
		rec.appliedPps = pps
	end

	local function rebuildTileStatic(rec)
		local pool = rec.slot.stat
		local tile = rec.tile
		beginPool(pool)
		for _, list in pairs(rec.contrib) do
			for i = 1, #list do
				local ops = list[i].ops
				local polys = ops.polys
				for p = 1, #polys do
					drawConvexPolygonOnTile(polys[p], tile, pool)
				end
				local rounds = ops.rounds
				for r = 1, #rounds do
					drawRoundShadowOnTile(rounds[r], tile, pool)
				end
			end
		end
		endPool(pool)
		rec.dirty = false
	end

	local function prepareBoundTile(rec)
		local pps = chooseTilePps(rec, rec.dist)
		applyTileGeometry(rec, pps)
		if rec.dirty then
			rebuildTileStatic(rec)
		end
	end

	-- Build queue: tiles whose static layer must be (re)drawn, nearest first.
	function processTileQueue(deadline)
		local processed = 0
		local minPer = CONFIG.MinTilesBuiltPerFrame
		while dirtyHead <= #dirtyQueue do
			local rec = dirtyQueue[dirtyHead]
			dirtyQueue[dirtyHead] = false
			dirtyHead = dirtyHead + 1
			rec.queued = false
			if rec.wanted and (rec.dirty or not rec.slot or rec.appliedPps == nil) then
				local slot = ensureTileBound(rec, rec.prio or rec.dist)
				if slot then
					prepareBoundTile(rec)
				end
			end
			processed = processed + 1
			if processed >= minPer and os.clock() >= deadline then
				break
			end
		end
		if dirtyHead > #dirtyQueue then
			clearTable(dirtyQueue)
			dirtyHead = 1
		end
	end

	-- Visibility / priority / LOD pass for every tile. Sliced over several frames
	-- (a big map has thousands of tiles) and restarted every TileRefreshInterval.
	local wantedScratch = {}
	local refreshActive = false
	local refreshIndex = 0
	local lastRefreshTime = -1e9
	local TILE_SCAN_SLICE = 400

	local function finishTileRefresh()
		local maxStatic = math.floor((CONFIG.MaxActiveCanvasSlots - CONFIG.DynamicSlotReserve) * (0.4 + 0.6 * qualityLevel))
		-- Keep the total canvas memory inside its budget by lowering resolution a step at a time.
		local budget = CONFIG.CanvasPixelBudget * (0.4 + 0.6 * qualityLevel)
		if totalCanvasPx > budget * 1.05 then
			lodBudgetStep = math.max(0.3, lodBudgetStep * 0.88)
		elseif totalCanvasPx < budget * 0.6 and lodBudgetStep < 1 then
			lodBudgetStep = math.min(1, lodBudgetStep * 1.06)
		end
		-- Importance ~ apparent size: how much shadow a tile holds versus how far away it is.
		-- A big far shadow then beats a tiny near one when slots are scarce.
		for i = 1, #wantedScratch do
			local rec = wantedScratch[i]
			local area = 0
			for _, list in pairs(rec.contrib) do
				for j = 1, #list do
					area = area + (list[j].area or 0)
				end
			end
			local tileArea = rec.halfU * rec.halfV * 4
			rec.prio = (rec.dist + 20) / math.sqrt(math.max(math.min(area, tileArea), 4))
		end
		table.sort(wantedScratch, function(a, b)
			return a.prio < b.prio
		end)
		for i = maxStatic + 1, #wantedScratch do
			wantedScratch[i].wanted = false
		end
		for i = 1, math.min(#wantedScratch, maxStatic) do
			local rec = wantedScratch[i]
			if not rec.queued then
				local needs = rec.dirty or not rec.slot
				if not needs then
					local pps = chooseTilePps(rec, rec.dist)
					needs = rec.appliedPps ~= pps
				end
				if needs then
					enqueueTile(rec)
				end
			end
		end
		for i = 1, #canvasSlots do
			local rec = canvasSlots[i].rec
			if rec and not rec.wanted and (currentFrameId - rec.lastDynFrame) > 20 then
				releaseTileSlot(rec)
			end
		end
	end

	function refreshTileStates(now)
		if not refreshActive then
			if now - lastRefreshTime < CONFIG.TileRefreshInterval then
				return
			end
			refreshActive = true
			refreshIndex = #tileRecList
			clearTable(wantedScratch)
		end
		local count = 0
		while refreshIndex >= 1 and count < TILE_SCAN_SLICE do
			local i = refreshIndex
			local rec = tileRecList[i]
			refreshIndex = i - 1
			count = count + 1
			if rec then
				local d = math.max(0, (rec.origin - camPos).Magnitude - rec.radius * 0.7)
				rec.dist = d
				local wanted = false
				if rec.nContrib > 0 and d <= effectiveRenderDistance() then
					wanted = d < CONFIG.NearAlwaysRadius or isSphereOnScreen(rec.origin, rec.radius * 1.15)
					-- Shadows must not float on a surface the player can no longer see.
					if wanted then
						local rp = rec.plane.part
						if rp and not rec.plane.isTerrain and not isPartOpaqueEnough(rp) then
							wanted = false
						end
					end
				end
				rec.wanted = wanted
				if rec.slot then
					local on = (currentFrameId - rec.lastDynFrame) < 20 or isSphereOnScreen(rec.origin, rec.radius * 1.3)
					if rec.onScreen ~= on then
						rec.onScreen = on
						syncSlotEnabled(rec.slot)
					end
				end
				if wanted then
					wantedScratch[#wantedScratch + 1] = rec
				elseif rec.nContrib == 0 and not rec.slot and (currentFrameId - rec.lastDynFrame) > 900 then
					tileRecs[rec.key] = nil
					table.remove(tileRecList, i)
				end
			end
		end
		if refreshIndex < 1 then
			refreshActive = false
			lastRefreshTime = now
			finishTileRefresh()
		end
	end

	-- ----------------------------------------------------------------------------
	-- Dynamic layer access (characters)
	-- ----------------------------------------------------------------------------
	function getDynamicTile(plane, tx, ty)
		local rec = getTileRec(plane, tx, ty)
		if not rec then
			return nil
		end
		if not rec.slot then
			rec.dist = math.max(0, (rec.origin - camPos).Magnitude - rec.radius * 0.6)
			if not ensureTileBound(rec, 0) then
				return nil
			end
		end
		if rec.dirty or rec.appliedPps == nil then
			prepareBoundTile(rec)
		end
		rec.lastDynFrame = currentFrameId
		local slot = rec.slot
		if slot.dynFrame ~= currentFrameId then
			slot.dynFrame = currentFrameId
			beginPool(slot.dyn)
			dynSlotsThisFrame[#dynSlotsThisFrame + 1] = slot
		end
		return rec.tile, slot.dyn
	end

	local appliedGroupTransparency = currentGroupTransparency
	function finalizeCanvasSlotsForFrame()
		for i = 1, #dynSlotsPrev do
			local slot = dynSlotsPrev[i]
			if slot.dynFrame ~= currentFrameId then
				beginPool(slot.dyn)
				endPool(slot.dyn)
			end
		end
		clearTable(dynSlotsPrev)
		for i = 1, #dynSlotsThisFrame do
			local slot = dynSlotsThisFrame[i]
			endPool(slot.dyn)
			dynSlotsPrev[#dynSlotsPrev + 1] = slot
		end
		clearTable(dynSlotsThisFrame)

		if math.abs(appliedGroupTransparency - currentGroupTransparency) > 0.004 then
			appliedGroupTransparency = currentGroupTransparency
			for i = 1, #canvasSlots do
				local slot = canvasSlots[i]
				if slot.rec and slot.gt ~= currentGroupTransparency then
					slot.gt = currentGroupTransparency
					slot.canvasGroup.GroupTransparency = currentGroupTransparency
				end
			end
		end
		currentFrameId = currentFrameId + 1
	end

	-- ----------------------------------------------------------------------------
	-- Contributions of static (map) casters to tiles
	-- ----------------------------------------------------------------------------
	function tileRangeForBounds(plane, minU, maxU, minV, maxV)
		minU = math.max(minU, -plane.halfU)
		maxU = math.min(maxU, plane.halfU)
		minV = math.max(minV, -plane.halfV)
		maxV = math.min(maxV, plane.halfV)
		if maxU <= minU or maxV <= minV then
			return nil
		end
		if not plane.isTiled then
			return 0, 0, 0, 0
		end
		local S = CONFIG.SharedTileSize
		return math.floor((minU + S * 0.5) / S), math.floor((maxU + S * 0.5) / S),
			math.floor((minV + S * 0.5) / S), math.floor((maxV + S * 0.5) / S)
	end

	local function attachToTile(state, rec, entry)
		local list = rec.contrib[state.part]
		if not list then
			list = {}
			rec.contrib[state.part] = list
			rec.nContrib = rec.nContrib + 1
		end
		if list[#list] ~= entry then
			list[#list + 1] = entry
		end
		state.tiles[rec] = true
		markTileDirty(rec)
	end

	function addEntryToTiles(state, entry)
		local plane, ops = entry.plane, entry.ops
		if not entry.area then
			local area = 0
			for _, poly in ipairs(ops.polys) do
				area = area + math.abs(polygonSignedArea(poly))
			end
			for _, r in ipairs(ops.rounds) do
				area = area + math.abs(polygonSignedArea(r.outline))
			end
			entry.area = area
		end
		-- Only tiles the shape really touches (not just its bounding box).
		local function visit(shape)
			local minU, maxU, minV, maxV = polygonBounds2D(shape)
			local tx0, tx1, ty0, ty1 = tileRangeForBounds(plane, minU, maxU, minV, maxV)
			if not tx0 then
				return
			end
			for tx = tx0, tx1 do
				for ty = ty0, ty1 do
					local rec = getTileRec(plane, tx, ty)
					if rec and not (state.tiles[rec] and rec.contrib[state.part]
						and rec.contrib[state.part][#rec.contrib[state.part]] == entry) then
						local touches = #clipPolygonToBox2D(shape,
							rec.centerU - rec.halfU, rec.centerU + rec.halfU,
							rec.centerV - rec.halfV, rec.centerV + rec.halfV) >= 3
						if touches then
							attachToTile(state, rec, entry)
						end
					end
				end
			end
		end
		for _, poly in ipairs(ops.polys) do
			visit(poly)
		end
		for _, r in ipairs(ops.rounds) do
			visit(r.outline)
		end
	end

	-- Shadow polygons already baked on `plane` that overlap the given plane-space rect.
	-- These are exactly the shapes the static layer paints, so a moving shadow can be
	-- merged with them (stencil semantics: never darken twice, never leave a gap).
	function collectStaticShadowPolys(plane, minU, maxU, minV, maxV, out, seen)
		local tx0, tx1, ty0, ty1 = tileRangeForBounds(plane, minU, maxU, minV, maxV)
		if not tx0 then
			return
		end
		for tx = tx0, tx1 do
			for ty = ty0, ty1 do
				local key = plane.baseKey
				if plane.isTiled then
					key = key .. "_" .. tostring(tx) .. "_" .. tostring(ty)
				end
				local rec = tileRecs[key]
				if rec then
					for _, list in pairs(rec.contrib) do
						for i = 1, #list do
							local ops = list[i].ops
							for p = 1, #ops.polys do
								local poly = ops.polys[p]
								if not seen[poly] then
									local a, b, c, d = polygonBounds2D(poly)
									if b >= minU and a <= maxU and d >= minV and c <= maxV then
										seen[poly] = true
										out[#out + 1] = poly
									end
								end
							end
							for r = 1, #ops.rounds do
								local poly = ops.rounds[r].outline
								if poly and not seen[poly] then
									local a, b, c, d = polygonBounds2D(poly)
									if b >= minU and a <= maxU and d >= minV and c <= maxV then
										seen[poly] = true
										out[#out + 1] = poly
									end
								end
							end
						end
					end
				end
			end
		end
	end

	function removeCasterContribs(state)
		for rec in pairs(state.tiles) do
			if rec.contrib[state.part] then
				rec.contrib[state.part] = nil
				rec.nContrib = rec.nContrib - 1
				markTileDirty(rec)
			end
		end
		state.tiles = {}
	end

	function getTileStats()
		local prims, bound = 0, 0
		for i = 1, #canvasSlots do
			local slot = canvasSlots[i]
			if slot.rec then
				bound = bound + 1
			end
			prims = prims + slot.stat.prevRect + slot.stat.prevDisc + slot.dyn.prevRect + slot.dyn.prevDisc
		end
		return bound, #tileRecList, prims, #dirtyQueue - dirtyHead + 1
	end

end

-- ============================================================================
-- RECEIVER PLANE EXTRACTION (BaseParts, cylinders, wedges & Terrain)
-- ============================================================================
local function getCylinderAxisAndRadius(part)
	local cf = part.CFrame
	local size = part.Size

	if part:IsA("Part") and part.Shape == Enum.PartType.Cylinder then
		return true, cf.RightVector, size.X * 0.5, math.min(size.Y, size.Z) * 0.5
	end

	local cylMesh = part:FindFirstChildOfClass("CylinderMesh")
	if cylMesh then
		local s = size * cylMesh.Scale
		return true, cf.UpVector, s.Y * 0.5, math.min(s.X, s.Z) * 0.5
	end

	local spMesh = part:FindFirstChildOfClass("SpecialMesh")
	if spMesh and spMesh.MeshType == Enum.MeshType.Cylinder then
		local s = size * spMesh.Scale
		if math.abs(s.X - s.Z) < 0.05 and math.abs(s.Y - s.X) > 0.1 then
			return true, cf.UpVector, s.Y * 0.5, math.min(s.X, s.Z) * 0.5
		end
		return true, cf.RightVector, s.X * 0.5, math.min(s.Y, s.Z) * 0.5
	end

	return false, VEC3_Y, 0, 0
end

local terrain = Workspace:FindFirstChildOfClass("Terrain")
local TERRAIN_PATCH_HALF = 14
local TERRAIN_SNAP = 8
local terrainPlaneCache = {}

local function makeTangentBasis(normal)
	local ref = (math.abs(normal.Y) < 0.95) and VEC3_Y or VEC3_X
	local tangentU = ref:Cross(normal).Unit
	local tangentV = normal:Cross(tangentU).Unit
	return tangentU, tangentV
end

local function extractTerrainPlane(hitNormal, hitPos)
	local n = hitNormal.Unit
	local qx = math.floor(n.X * 8 + 0.5)
	local qy = math.floor(n.Y * 8 + 0.5)
	local qz = math.floor(n.Z * 8 + 0.5)
	local qn = Vector3.new(qx, qy, qz)
	if qn.Magnitude < 1e-3 then
		return nil
	end
	n = qn.Unit
	local gx = math.floor(hitPos.X / TERRAIN_SNAP + 0.5)
	local gz = math.floor(hitPos.Z / TERRAIN_SNAP + 0.5)
	local snapped = Vector3.new(gx * TERRAIN_SNAP, hitPos.Y, gz * TERRAIN_SNAP)
	local origin = snapped - n * (snapped - hitPos):Dot(n)
	local gy = math.floor(origin.Y / 2 + 0.5)
	local key = "T_" .. gx .. "_" .. gy .. "_" .. gz .. "_" .. qx .. "_" .. qy .. "_" .. qz
	local cachedPlane = terrainPlaneCache[key]
	if cachedPlane then
		return cachedPlane
	end
	local tangentU, tangentV = makeTangentBasis(n)
	local newPlane = {
		part = terrain,
		isTerrain = true,
		origin = origin,
		normal = n,
		tangentU = tangentU,
		tangentV = tangentV,
		halfU = TERRAIN_PATCH_HALF,
		halfV = TERRAIN_PATCH_HALF,
		baseKey = key,
		isTiled = false,
		isCircularDisk = false,
	}
	terrainPlaneCache[key] = newPlane
	return newPlane
end

local function extractReceiverPlane(part, hitNormal, hitPos, minFaceSpan)
	if terrain and part == terrain then
		return extractTerrainPlane(hitNormal, hitPos)
	end
	if not part:IsA("BasePart") or not isPartOpaqueEnough(part) then
		return nil
	end

	local cf = part.CFrame
	local size = part.Size * 0.5
	local spMesh = part:FindFirstChildOfClass("SpecialMesh")
	if spMesh and spMesh.MeshType == Enum.MeshType.Brick then
		size = size * spMesh.Scale
	else
		local blkMesh = part:FindFirstChildOfClass("BlockMesh")
		if blkMesh then
			size = size * blkMesh.Scale
		end
	end

	local localNormal = cf:VectorToObjectSpace(hitNormal)
	local absX = math.abs(localNormal.X)
	local absY = math.abs(localNormal.Y)
	local absZ = math.abs(localNormal.Z)

	local origin, normal, tangentU, tangentV, halfU, halfV, baseKey
	local isCircularDisk = false
	local partUid = getPartUid(part)

	local isCyl, cylAxis, _, cylRadius = getCylinderAxisAndRadius(part)
	if isCyl then
		local dotAxis = hitNormal:Dot(cylAxis)
		if math.abs(dotAxis) <= 0.75 then
			return nil
		end
		local signA = (dotAxis >= 0) and 1 or -1
		normal = cylAxis * signA
		origin = cf.Position + normal * (hitPos - cf.Position):Dot(normal)
		tangentU, tangentV = makeTangentBasis(normal)
		halfU = cylRadius
		halfV = cylRadius
		isCircularDisk = true
		baseKey = partUid .. (signA > 0 and "_CylTop" or "_CylBot")
	elseif part:IsA("WedgePart") and absY > 0.1 and absZ > 0.1 then
		normal = hitNormal.Unit
		tangentU = cf.RightVector
		tangentV = normal:Cross(tangentU).Unit
		origin = cf.Position + normal * (hitPos - cf.Position):Dot(normal)
		halfU = size.X
		halfV = math.sqrt(size.Y * size.Y + size.Z * size.Z)
		baseKey = partUid .. "_Slope"
	elseif absY >= absX and absY >= absZ then
		local signY = (localNormal.Y >= 0) and 1 or -1
		normal = cf.UpVector * signY
		origin = cf.Position + normal * (hitPos - cf.Position):Dot(normal)
		tangentU = cf.RightVector
		tangentV = normal:Cross(tangentU).Unit
		halfU = size.X
		halfV = size.Z
		baseKey = partUid .. (signY > 0 and "_Top" or "_Bottom")
	elseif absX >= absY and absX >= absZ then
		local signX = (localNormal.X >= 0) and 1 or -1
		normal = cf.RightVector * signX
		origin = cf.Position + normal * (hitPos - cf.Position):Dot(normal)
		tangentU = -cf.LookVector * signX
		tangentV = normal:Cross(tangentU).Unit
		halfU = size.Z
		halfV = size.Y
		baseKey = partUid .. (signX > 0 and "_Right" or "_Left")
	else
		local signZ = (localNormal.Z >= 0) and 1 or -1
		normal = -cf.LookVector * signZ
		origin = cf.Position + normal * (hitPos - cf.Position):Dot(normal)
		tangentU = cf.RightVector * signZ
		tangentV = normal:Cross(tangentU).Unit
		halfU = size.X
		halfV = size.Y
		baseKey = partUid .. (signZ > 0 and "_Back" or "_Front")
	end

	local reqSpan = minFaceSpan or CONFIG.MinReceiverFaceSize
	if halfU * 2 < reqSpan or halfV * 2 < reqSpan then
		return nil
	end

	-- Curved meshes (trees, rocks, props) only receive when they are flat slabs;
	-- otherwise their bounding-box face would float in the air.
	if not isCircularDisk and (part:IsA("MeshPart")
		or (spMesh and spMesh.MeshType == Enum.MeshType.FileMesh)) then
		local ln = cf:VectorToObjectSpace(normal)
		local thickness = part.Size:Dot(Vector3.new(math.abs(ln.X), math.abs(ln.Y), math.abs(ln.Z)))
		if thickness > math.max(1.5, 0.15 * math.min(halfU, halfV) * 2) then
			return nil
		end
	end

	local tileThreshold = CONFIG.SharedTileSize * 0.65
	return {
		part = part,
		origin = origin,
		normal = normal,
		tangentU = tangentU,
		tangentV = tangentV,
		halfU = halfU,
		halfV = halfV,
		baseKey = baseKey,
		isTiled = (not isCircularDisk) and ((halfU > tileThreshold) or (halfV > tileThreshold)),
		isCircularDisk = isCircularDisk,
	}
end

local DISK_SEGMENTS = 20
local function makeDiskPolygon2D(radius)
	local poly = {}
	for i = 0, DISK_SEGMENTS - 1 do
		local a = (i / DISK_SEGMENTS) * math.pi * 2
		poly[i + 1] = Vector2.new(math.cos(a) * radius, math.sin(a) * radius)
	end
	return poly
end

-- Receiver outline in its own (u, v) coordinates, counter-clockwise.
local function getReceiverPolygon2D(plane)
	if plane.receiverPoly then
		return plane.receiverPoly
	end
	local poly
	if plane.isCircularDisk then
		poly = makeDiskPolygon2D(plane.halfU * 0.995)
	else
		poly = rectPolygon2D(-plane.halfU, plane.halfU, -plane.halfV, plane.halfV)
	end
	plane.receiverPoly = poly
	return poly
end

local function worldToPlane2D(plane, p)
	local rel = p - plane.origin
	return Vector2.new(rel:Dot(plane.tangentU), rel:Dot(plane.tangentV))
end

local function planeToWorld(plane, uv)
	return plane.origin + plane.tangentU * uv.X + plane.tangentV * uv.Y
end

-- ============================================================================
-- RASTERIZERS (vector-smooth discs, capsules and convex polygons)
-- ============================================================================
local function drawEllipse2D(pool, cx, cy, rMinorPx, rMajorPx, majorU, majorV)
	local dMinor = math.max(2, rMinorPx * 2)
	local dMajor = math.max(dMinor, rMajorPx * 2)
	local stretch = dMajor - dMinor
	if stretch <= 2.0 then
		local avgD = (dMinor + dMajor) * 0.5
		setPrimitive(acquireDisc(pool), cx, cy, avgD, avgD, 0)
	else
		local halfShift = stretch * 0.5
		local sx = majorU * halfShift
		local sy = majorV * halfShift
		setPrimitive(acquireDisc(pool), cx - sx, cy - sy, dMinor, dMinor, 0)
		setPrimitive(acquireDisc(pool), cx + sx, cy + sy, dMinor, dMinor, 0)
		setPrimitive(acquireRect(pool), cx, cy, stretch + 0.5, dMinor, math.deg(math.atan2(majorV, majorU)))
	end
end

function drawRoundShadowOnTile(r, tile, pool)
	local pad = math.max(r.rMajor, r.rMinor, r.rShaft) + 0.3
	if math.max(r.u1, r.u2) + pad < tile.centerU - tile.halfU or math.min(r.u1, r.u2) - pad > tile.centerU + tile.halfU
		or math.max(r.v1, r.v2) + pad < tile.centerV - tile.halfV or math.min(r.v1, r.v2) - pad > tile.centerV + tile.halfV then
		return
	end
	local scale = (tile.scaleX + tile.scaleY) * 0.5
	local x1 = (r.u1 - tile.centerU + tile.halfU) * tile.scaleX
	local y1 = (-r.v1 + tile.centerV + tile.halfV) * tile.scaleY
	local x2 = (r.u2 - tile.centerU + tile.halfU) * tile.scaleX
	local y2 = (-r.v2 + tile.centerV + tile.halfV) * tile.scaleY

	local rMinorPx = math.max(1.2, r.rMinor * scale)
	local rMajorPx = math.max(rMinorPx, r.rMajor * scale)
	local rShaftPx = math.max(1.2, r.rShaft * scale)
	local majPxX, majPxY = r.majorU, -r.majorV

	drawEllipse2D(pool, x1, y1, rMinorPx, rMajorPx, majPxX, majPxY)
	local dx = x2 - x1
	local dy = y2 - y1
	local distPx = math.sqrt(dx * dx + dy * dy)
	if distPx > 1.0 then
		drawEllipse2D(pool, x2, y2, rMinorPx, rMajorPx, majPxX, majPxY)
		setPrimitive(acquireRect(pool), (x1 + x2) * 0.5, (y1 + y2) * 0.5, distPx + 0.5, rShaftPx * 2, math.deg(math.atan2(dy, dx)))
	end
end

-- ============================================================================
-- CONVEX POLYGON FILL (pixel space)
-- ============================================================================
-- A GUI Frame can only be a rectangle, so a polygon is built from rotated rectangles:
--   * STRIPS along the best axis, measured with INNER chords (they never poke outside).
--   * graded BANDS along every slanted edge: the exact edge, they also close the gaps the
--     strips leave beside slanted sides and reach into sharp tips.
--   * every internal boundary overlaps by a pixel or two, so rotated edges never leave seams.
-- Measured on 1,100 random shadow-like polygons (offline coverage test): about 20 primitives
-- (the old method used ~36), the largest hole ~50 px^2 (was ~1,800 px^2) and no overshoot.
do
local diskClipCache = {}

local OVERLAP = 1.6
local fillPool = nil

local function emit(kind, cx, cy, w, h, rot)
	if kind == "disc" then
		setPrimitive(acquireDisc(fillPool), cx, cy, w, h, 0)
	else
		setPrimitive(acquireRect(fillPool), cx, cy, w, h, rot)
	end
end

local function simplifyPoly(poly)
	local out = {}
	local n = #poly
	for i = 1, n do
		local p = poly[i]
		local q = out[#out]
		if not q or (p - q).Magnitude > 0.25 then
			out[#out + 1] = p
		end
	end
	if #out > 1 and (out[1] - out[#out]).Magnitude <= 0.25 then
		out[#out] = nil
	end
	-- drop (nearly) collinear vertices
	local changed = true
	while changed and #out > 3 do
		changed = false
		for i = 1, #out do
			local a = out[(i - 2) % #out + 1]
			local b = out[i]
			local c = out[i % #out + 1]
			local cr = (b.X - a.X) * (c.Y - b.Y) - (b.Y - a.Y) * (c.X - b.X)
			local len = (c - a).Magnitude
			if len > 0 and math.abs(cr) / len < 0.12 then
				table.remove(out, i)
				changed = true
				break
			end
		end
	end
	return out
end

local function toLocal(poly, dx, dy)
	-- rotation into the axis frame: x' = p.d , y' = p.n  with n = (-dy, dx)
	local out = {}
	for i = 1, #poly do
		local p = poly[i]
		out[i] = Vector2.new(p.X * dx + p.Y * dy, -p.X * dy + p.Y * dx)
	end
	return out
end

-- Chord of the polygon at height y (nil outside). Heights are clamped half a pixel inside
-- the polygon so an edge that is parallel to the strips up to a tiny tilt still has a
-- usable chord at the extreme level.
local function chordAt(lp, y, ymin, ymax)
	if ymin then
		y = math.max(ymin + 0.5, math.min(ymax - 0.5, y))
	end
	local xl, xr = convexChordAtY(lp, y)
	if not xl then
		return nil, nil
	end
	return xl, xr
end

-- Vertex levels of the polygon in the axis frame (strips follow them, so every piece
-- between two levels has exactly straight sides).
local function levelsOf(lp, ymin, ymax)
	local ys = {}
	for i = 1, #lp do ys[i] = lp[i].Y end
	table.sort(ys)
	local out = { ymin }
	for i = 1, #ys do
		local y = ys[i]
		if y > out[#out] + 0.6 and y < ymax - 0.6 then
			out[#out + 1] = y
		end
	end
	out[#out + 1] = ymax
	return out
end

-- Strip schedule shared by counting and emitting. visit(y0, y1) per strip.
local function stripSchedule(lp, levels, tBase, tmin, visit)
	local count = 0
	for k = 1, #levels - 1 do
		local ya, yb = levels[k], levels[k + 1]
		local l0, r0 = chordAt(lp, ya, levels[1], levels[#levels])
		local l1, r1 = chordAt(lp, yb, levels[1], levels[#levels])
		if l0 and l1 then
			if math.abs(l1 - l0) < 0.15 and math.abs(r1 - r0) < 0.15 then
				-- both sides parallel to the axis: a single strip
				count = count + 1
				if visit then visit(ya, yb) end
			else
				local len = yb - ya
				-- A strip loses at most (slope * thickness) of width at its slanted ends. Where
				-- the sides are almost parallel to the strip direction (slope ~ 0) strips can
				-- be thick; steep sides get thin strips and the edge bands finish the job.
				local slope = math.max(math.abs(l1 - l0), math.abs(r1 - r0)) / len
				local tAllow = math.min(math.max(tBase, 1.2 / math.max(slope, 1e-6)), 48)
				local n = math.min(400, math.max(1, math.ceil(len / tAllow - 1e-6)))
				local t = len / n
				if t < tmin and n > 1 then
					n = math.max(1, math.floor(len / tmin))
					t = len / n
				end
				for j = 0, n - 1 do
					count = count + 1
					if visit then visit(ya + j * t, (j == n - 1) and yb or (ya + (j + 1) * t)) end
				end
			end
		end
	end
	return count
end

-- Chooses the strip axis and the strip thickness. The thickness must stay below the
-- polygon's own minimum width (otherwise the inner chord vanishes on thin slivers).
local function chooseAxis(poly, maxDim, opts)
	local candidates = { { 1, 0 }, { 0, 1 } }
	local n = #poly
	-- axes of the three longest edges
	local top = {}
	for i = 1, n do
		local a, b = poly[i], poly[i % n + 1]
		local e = b - a
		local len = e.Magnitude
		if len > 3 then
			top[#top + 1] = { len, e.X / len, e.Y / len }
		end
	end
	table.sort(top, function(p, q)
		return p[1] > q[1]
	end)
	for i = 1, math.min(3, #top) do
		candidates[#candidates + 1] = { top[i][2], top[i][3] }
	end
	local minWidth = math.huge
	for _, c in ipairs(candidates) do
		local lp = toLocal(poly, c[1], c[2])
		local ymin, ymax = math.huge, -math.huge
		for _, p in ipairs(lp) do
			if p.Y < ymin then ymin = p.Y end
			if p.Y > ymax then ymax = p.Y end
		end
		c.lp, c.ymin, c.ymax = lp, ymin, ymax
		local ext = ymax - ymin
		if ext < minWidth then minWidth = ext end
	end
	local tCap = opts.tCap or math.clamp((opts.capFrac or 0.03) * maxDim, 3, opts.capMax or 12)
	local tBase = math.clamp(0.45 * minWidth, 0.9, tCap)
	local tmin = math.min(opts.tmin or 1.5, tBase * 0.6)
	local best, bestCost = nil, math.huge
	for _, c in ipairs(candidates) do
		local cost = stripSchedule(c.lp, levelsOf(c.lp, c.ymin, c.ymax), tBase, tmin, nil)
		if cost < bestCost then
			best, bestCost = c, cost
		end
	end
	return best[1], best[2], tBase, tmin
end

-- inner-safe interval [u0,u1] along edge i for a band of depth T
local function bandInterval(poly, normals, i, ex, ey, mx, my, T)
	local n = #poly
	local A = poly[i]
	local L = (poly[i % n + 1] - A).Magnitude
	local lo, hi = 0, L
	for j = 1, n do
		if j ~= i then
			local nx, ny = normals[j].X, normals[j].Y
			local Aj = poly[j]
			local c = nx * Aj.X + ny * Aj.Y
			local a = nx * ex + ny * ey
			for _, v in ipairs({ 0, T }) do
				local b = nx * A.X + ny * A.Y + (nx * mx + ny * my) * v - c
				if math.abs(a) < 1e-9 then
					if b < -0.05 then
						return nil
					end
				elseif a > 0 then
					lo = math.max(lo, (-0.05 - b) / a)
				else
					hi = math.min(hi, (-0.05 - b) / a)
				end
			end
		end
	end
	if hi - lo < 1.0 then
		return nil
	end
	return lo, hi
end

-- Moving shapes (characters) are redrawn every frame, so they use a slightly coarser fill.
local STATIC_FILL = {}
local MOVING_FILL = { capFrac = 0.08, capMax = 14 }

local function fillConvexPx(polyIn, pool)
	fillPool = pool
	local opts = pool.dynamic and MOVING_FILL or STATIC_FILL
	local poly = simplifyPoly(polyIn)
	local n = #poly
	if n < 3 then
		return 0
	end
	if polygonSignedArea(poly) < 0 then
		local r = {}
		for i = 1, n do r[i] = poly[n - i + 1] end
		poly = r
	end
	local minX, maxX, minY, maxY = polygonBounds2D(poly)
	local w, h = maxX - minX, maxY - minY
	if w < 2.5 and h < 2.5 then
		local d = math.max(w, h, 1.2)
		emit("disc", (minX + maxX) * 0.5, (minY + maxY) * 0.5, d, d, 0)
		return 1
	end
	local maxDim = math.max(w, h)
	local dx, dy, tBase, tmin = chooseAxis(poly, maxDim, opts)
	local lp = toLocal(poly, dx, dy)
	local ymin, ymax = math.huge, -math.huge
	for _, p in ipairs(lp) do
		if p.Y < ymin then ymin = p.Y end
		if p.Y > ymax then ymax = p.Y end
	end
	local rot = math.deg(math.atan2(dy, dx))
	local nxx, nyy = -dy, dx
	local emitted = 0
	-- 1) strips (inner chords)
	stripSchedule(lp, levelsOf(lp, ymin, ymax), tBase, tmin, function(ya, yb)
		-- width = inner chord of the strip's OWN range; only the thickness grows by the
		-- overlap (perpendicular overshoot stays below OVERLAP/2 px).
		local a = (ya <= ymin + 1e-6) and ya or (ya - OVERLAP * 0.5)
		local b = (yb >= ymax - 1e-6) and yb or (yb + OVERLAP * 0.5)
		local l0, r0 = chordAt(lp, ya, ymin, ymax)
		local l1, r1 = chordAt(lp, yb, ymin, ymax)
		if l0 and l1 then
			local xl = math.max(l0, l1)
			local xr = math.min(r0, r1)
			if xr - xl > 0.6 then
				local cx, cy = (xl + xr) * 0.5, (a + b) * 0.5
				emit("rect", dx * cx + nxx * cy, dy * cx + nyy * cy, xr - xl, b - a, rot)
				emitted = emitted + 1
			end
		end
	end)
	-- 2) bands along slanted edges
	local normals = {}
	for i = 1, n do
		local a, b = poly[i], poly[i % n + 1]
		local e = b - a
		local len = e.Magnitude
		if len < 1e-6 then len = 1 end
		normals[i] = Vector2.new(-e.Y / len, e.X / len)
	end
	local T0 = tBase + OVERLAP + 0.6
	for i = 1, n do
		local a, b = poly[i], poly[i % n + 1]
		local e = b - a
		local len = e.Magnitude
		if len > 3 then
			local ex, ey = e.X / len, e.Y / len
			local cosA = math.abs(ex * dx + ey * dy)          -- 1 = parallel to the strip axis
			local sinA = math.sqrt(math.max(0, 1 - cosA * cosA))
			-- flush with the strips only if the edge drifts < 0.7 px over its whole length
			local parallel = len * sinA < 0.7
			local perpendicular = len * cosA < 0.7
			if not parallel and not perpendicular then
				local mx, my = normals[i].X, normals[i].Y
				-- Graded bands: deep first, then thinner and thinner. Thin bands fit closer
				-- to acute tips, so together they cover them.
				local T = T0
				local rotE = math.deg(math.atan2(ey, ex))
				local lastU0, lastU1 = nil, nil
				local guard = 0
				while T >= 1.2 and guard < 12 do
					guard = guard + 1
					local u0, u1 = bandInterval(poly, normals, i, ex, ey, mx, my, T)
					if u0 and not (lastU0 and u0 >= lastU0 - 0.5 and u1 <= lastU1 + 0.5) then
						local um = (u0 + u1) * 0.5
						emit("rect", a.X + ex * um + mx * (T * 0.5), a.Y + ey * um + my * (T * 0.5), u1 - u0, T, rotE)
						emitted = emitted + 1
						lastU0, lastU1 = u0, u1
					end
					T = T * 0.45
				end
			end
		end
	end
	return emitted
end


function drawConvexPolygonOnTile(polyStuds, tile, pool)
	local pMinU, pMaxU, pMinV, pMaxV = polygonBounds2D(polyStuds)
	if pMaxU < tile.centerU - tile.halfU or pMinU > tile.centerU + tile.halfU
		or pMaxV < tile.centerV - tile.halfV or pMinV > tile.centerV + tile.halfV then
		return
	end
	local workingPoly = ensureCCW(polyStuds)
	if tile.isCircularDisk then
		local r = tile.diskRadius
		local disk = diskClipCache[r]
		if not disk then
			disk = makeDiskPolygon2D(r * 0.995)
			diskClipCache[r] = disk
		end
		workingPoly = clipPolygonByConvex2D(workingPoly, disk)
		if #workingPoly < 3 then
			return
		end
	end

	local localPoly = {}
	for i = 1, #workingPoly do
		local p = workingPoly[i]
		localPoly[i] = Vector2.new(p.X - tile.centerU, p.Y - tile.centerV)
	end
	local clipped = clipPolygonToRect2D(localPoly, tile.halfU, tile.halfV)
	local n = #clipped
	if n < 3 then
		return
	end

	-- Pixel space (y down).
	local polyPx = {}
	for i = 1, n do
		local p = clipped[n - i + 1]
		polyPx[i] = Vector2.new((p.X + tile.halfU) * tile.scaleX, (-p.Y + tile.halfV) * tile.scaleY)
	end
	fillConvexPx(polyPx, pool)
end
end


-- ============================================================================
-- CASTER HULLS (map parts)
-- ============================================================================
local BLOCK_CORNERS = {
	Vector3.new(-0.5, -0.5, -0.5), Vector3.new(0.5, -0.5, -0.5),
	Vector3.new(-0.5, 0.5, -0.5), Vector3.new(0.5, 0.5, -0.5),
	Vector3.new(-0.5, -0.5, 0.5), Vector3.new(0.5, -0.5, 0.5),
	Vector3.new(-0.5, 0.5, 0.5), Vector3.new(0.5, 0.5, 0.5),
}

local function boxCorners(cf, size)
	local verts = {}
	local sx, sy, sz = size.X, size.Y, size.Z
	for i = 1, 8 do
		local lc = BLOCK_CORNERS[i]
		verts[i] = cf * Vector3.new(lc.X * sx, lc.Y * sy, lc.Z * sz)
	end
	return verts
end

local function makeBoxHull(part, cf, size)
	return {
		shapeType = "Box",
		verts = boxCorners(cf, size),
		center = cf.Position,
		extent = size.Magnitude * 0.5,
		sourcePart = part,
	}
end

-- Visual box of a part as (local offset, size): block-mesh scale and mesh offset
-- applied. Head meshes are narrower than their part.
local function getPartVisualBoxLocal(part)
	local size = part.Size
	local off = VEC3_ZERO
	local sp = part:FindFirstChildOfClass("SpecialMesh")
	if sp then
		off = sp.Offset
		local mt = sp.MeshType
		if mt == Enum.MeshType.Head then
			size = Vector3.new(size.X * 0.5, size.Y, size.Z) * sp.Scale
		elseif mt == Enum.MeshType.Brick or mt == Enum.MeshType.Sphere or mt == Enum.MeshType.Cylinder then
			size = size * sp.Scale
		end
	else
		local bm = part:FindFirstChildOfClass("BlockMesh")
		if bm then
			off = bm.Offset
			size = size * bm.Scale
		end
	end
	return off, size
end

local function getPartVisualBox(part)
	local off, size = getPartVisualBoxLocal(part)
	local cf = part.CFrame
	if off.X ~= 0 or off.Y ~= 0 or off.Z ~= 0 then
		cf = cf * CFrame.new(off)
	end
	return cf, size
end

local function makeEllipsoidHull(part, cf, radii)
	return {
		shapeType = "Ellipsoid",
		cf = cf,
		center = cf.Position,
		radii = radii,
		extent = radii.Magnitude,
		sourcePart = part,
	}
end

local function extractMapPartHull(part)
	local cf = part.CFrame
	local size = part.Size
	local specialMesh = part:FindFirstChildOfClass("SpecialMesh")

	if (part:IsA("Part") and part.Shape == Enum.PartType.Ball)
		or (specialMesh and specialMesh.MeshType == Enum.MeshType.Sphere) then
		if specialMesh then
			cf = cf * CFrame.new(specialMesh.Offset)
			size = size * specialMesh.Scale
		end
		local r = math.max(size.X, size.Y, size.Z) * 0.5
		return {
			shapeType = "Sphere",
			endPoint1 = cf.Position,
			endPoint2 = cf.Position,
			center = cf.Position,
			radius = r,
			extent = r,
			sourcePart = part,
		}
	end

	local isCyl, cylAxis, cylHalfH, cylRadius = getCylinderAxisAndRadius(part)
	if isCyl then
		local pos = cf.Position
		local step = cylAxis * cylHalfH
		return {
			shapeType = "Cylinder",
			endPoint1 = pos - step,
			endPoint2 = pos + step,
			center = pos,
			cylAxis = cylAxis,
			radius = cylRadius,
			extent = math.sqrt(cylHalfH * cylHalfH + cylRadius * cylRadius),
			sourcePart = part,
		}
	end

	if part:IsA("WedgePart") then
		local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
		return {
			shapeType = "Box",
			verts = {
				cf * Vector3.new(-hx, -hy, -hz), cf * Vector3.new(hx, -hy, -hz),
				cf * Vector3.new(-hx, -hy, hz), cf * Vector3.new(hx, -hy, hz),
				cf * Vector3.new(-hx, hy, hz), cf * Vector3.new(hx, hy, hz),
			},
			center = cf.Position,
			extent = size.Magnitude * 0.5,
			sourcePart = part,
		}
	end

	local isCurved = part:IsA("MeshPart") or part:IsA("UnionOperation")
	if specialMesh then
		cf = cf * CFrame.new(specialMesh.Offset)
		if specialMesh.MeshType == Enum.MeshType.Brick then
			size = size * specialMesh.Scale
		else
			isCurved = true
		end
	end
	if isCurved then
		-- Mesh bounding boxes overestimate the visible volume slightly.
		size = size * 0.92
	end
	return makeBoxHull(part, cf, size)
end

-- ============================================================================
-- LIGHT PROJECTION ONTO A RECEIVER PLANE
-- ============================================================================
local function sampleEllipseInto(out, cu, cv, majorU, majorV, rMajor, rMinor, segments)
	local minU, minV = -majorV, majorU
	for i = 0, segments - 1 do
		local a = (i / segments) * math.pi * 2
		local ca, sa = math.cos(a) * rMajor, math.sin(a) * rMinor
		table.insert(out, Vector2.new(cu + majorU * ca + minU * sa, cv + majorV * ca + minV * sa))
	end
end

local function finishRoundProjection(proj)
	local pts = {}
	sampleEllipseInto(pts, proj.u1, proj.v1, proj.majorU, proj.majorV, proj.rMajor, proj.rMinor, 14)
	if (proj.u2 - proj.u1) ^ 2 + (proj.v2 - proj.v1) ^ 2 > 1e-4 then
		sampleEllipseInto(pts, proj.u2, proj.v2, proj.majorU, proj.majorV, proj.rMajor, proj.rMinor, 14)
	end
	proj.outline = computeConvexHull2D(pts)
	return proj
end

local function computeHullProjection(hull, lightDir, plane)
	if plane.part == hull.sourcePart then
		return nil
	end
	local n = plane.normal
	local nDotL = n:Dot(lightDir)
	if nDotL >= -0.03 then
		return nil
	end

	local tCenter = (plane.origin - hull.center):Dot(n) / nDotL
	if tCenter < -(hull.extent + 0.5) or tCenter > CONFIG.MaxShadowDistance then
		return nil
	end

	if hull.shapeType == "Ellipsoid" then
		-- Exact silhouette of an ellipsoid: the great circle perpendicular to A^-1 * L.
		local rad = hull.radii
		local lL = hull.cf:VectorToObjectSpace(lightDir)
		local w = Vector3.new(lL.X / math.max(rad.X, 1e-3), lL.Y / math.max(rad.Y, 1e-3), lL.Z / math.max(rad.Z, 1e-3))
		local wl = w.Magnitude
		if wl < 1e-6 then
			return nil
		end
		w = w / wl
		local ref = (math.abs(w.Y) < 0.9) and VEC3_Y or VEC3_X
		local e1 = w:Cross(ref).Unit
		local e2 = w:Cross(e1)
		local pts = {}
		for i = 0, 7 do
			local a = (i / 8) * math.pi * 2
			local x = (e1 * math.cos(a) + e2 * math.sin(a)) * 1.04
			local p = hull.center + hull.cf:VectorToWorldSpace(Vector3.new(x.X * rad.X, x.Y * rad.Y, x.Z * rad.Z))
			local t = (plane.origin - p):Dot(n) / nDotL
			if t >= -0.35 and t <= CONFIG.MaxShadowDistance then
				pts[#pts + 1] = worldToPlane2D(plane, p + lightDir * math.max(t, 0))
			end
		end
		if #pts < 3 then
			return nil
		end
		local poly = computeConvexHull2D(pts)
		if #poly < 3 or math.abs(polygonSignedArea(poly)) < 1e-4 then
			return nil
		end
		return { plane = plane, poly = poly, round = false }
	end

	if hull.shapeType == "Sphere" or hull.shapeType == "Cylinder" then
		local t1 = (plane.origin - hull.endPoint1):Dot(n) / nDotL
		local t2 = (plane.origin - hull.endPoint2):Dot(n) / nDotL
		if math.max(t1, t2) < -hull.radius or math.min(t1, t2) > CONFIG.MaxShadowDistance then
			return nil
		end
		local uv1 = worldToPlane2D(plane, hull.endPoint1 + lightDir * math.max(t1, 0))
		local uv2 = worldToPlane2D(plane, hull.endPoint2 + lightDir * math.max(t2, 0))
		local proj = { plane = plane, round = true, u1 = uv1.X, v1 = uv1.Y, u2 = uv2.X, v2 = uv2.Y }

		if hull.shapeType == "Sphere" then
			local lu = lightDir:Dot(plane.tangentU)
			local lv = lightDir:Dot(plane.tangentV)
			local lLen = math.sqrt(lu * lu + lv * lv)
			proj.majorU = (lLen > 1e-4) and (lu / lLen) or 1
			proj.majorV = (lLen > 1e-4) and (lv / lLen) or 0
			proj.rMinor = hull.radius
			proj.rMajor = hull.radius / math.clamp(-nDotL, 0.3, 1.0)
		else
			-- Exact ellipse of the projected end disc (two conjugate semi-axes).
			local cylAxis = hull.cylAxis
			local upRef = (math.abs(cylAxis.Y) < 0.99) and VEC3_Y or VEC3_X
			local b1 = cylAxis:Cross(upRef).Unit
			local b2 = cylAxis:Cross(b1).Unit
			local p1 = b1 - lightDir * (b1:Dot(n) / nDotL)
			local p2 = b2 - lightDir * (b2:Dot(n) / nDotL)
			local R = hull.radius
			local e1x = math.clamp(p1:Dot(plane.tangentU) * R, -R * 3.5, R * 3.5)
			local e1y = math.clamp(p1:Dot(plane.tangentV) * R, -R * 3.5, R * 3.5)
			local e2x = math.clamp(p2:Dot(plane.tangentU) * R, -R * 3.5, R * 3.5)
			local e2y = math.clamp(p2:Dot(plane.tangentV) * R, -R * 3.5, R * 3.5)
			local e1Sq = e1x * e1x + e1y * e1y
			local e2Sq = e2x * e2x + e2y * e2y
			local avg = 0.5 * (e1Sq + e2Sq)
			local diff = 0.5 * (e1Sq - e2Sq)
			local crossDot = e1x * e2x + e1y * e2y
			local root = math.sqrt(diff * diff + crossDot * crossDot)
			proj.rMajor = math.sqrt(math.max(0.01, avg + root))
			proj.rMinor = math.sqrt(math.max(0.01, avg - root))
			local theta = 0.5 * math.atan2(crossDot, diff)
			local ct, st = math.cos(theta), math.sin(theta)
			local majX = e1x * ct + e2x * st
			local majY = e1y * ct + e2y * st
			local majLen = math.sqrt(majX * majX + majY * majY)
			proj.majorU = (majLen > 1e-4) and (majX / majLen) or 1
			proj.majorV = (majLen > 1e-4) and (majY / majLen) or 0
		end

		-- Shaft half-width perpendicular to the segment.
		local du, dv = proj.u2 - proj.u1, proj.v2 - proj.v1
		local dLen = math.sqrt(du * du + dv * dv)
		proj.rShaft = proj.rMinor
		if dLen > 1e-3 then
			local perpU, perpV = -dv / dLen, du / dLen
			local pm = proj.majorU * perpU + proj.majorV * perpV
			local pn = -proj.majorV * perpU + proj.majorU * perpV
			proj.rShaft = math.sqrt((proj.rMajor * pm) ^ 2 + (proj.rMinor * pn) ^ 2)
		end
		return finishRoundProjection(proj)
	end

	local pts = {}
	local verts = hull.verts
	for i = 1, #verts do
		local v = verts[i]
		local t = (plane.origin - v):Dot(n) / nDotL
		if t >= -0.35 and t <= CONFIG.MaxShadowDistance then
			table.insert(pts, worldToPlane2D(plane, v + lightDir * math.max(t, 0)))
		end
	end
	if #pts < 3 then
		return nil
	end
	local poly = computeConvexHull2D(pts)
	if #poly < 3 or math.abs(polygonSignedArea(poly)) < 1e-4 then
		return nil
	end
	return { plane = plane, poly = poly, round = false }
end

-- ============================================================================
-- OCCLUSION: a shadow only lands where the light reaches the receiver
-- ============================================================================
-- Shadow of an occluding part on `plane` (CCW polygon in plane coordinates).
local function computeOccluderShadow2D(occluder, plane, lightDir)
	if terrain and occluder == terrain then
		return nil
	end
	if not occluder:IsA("BasePart") then
		return nil
	end
	local n = plane.normal
	local nDotL = n:Dot(lightDir)
	if nDotL >= -0.03 then
		return nil
	end
	local cf, size = getPartVisualBox(occluder)
	local corners = boxCorners(cf, size)
	local pts = {}
	local anyInFront = false
	for i = 1, 8 do
		local c = corners[i]
		local t = (plane.origin - c):Dot(n) / nDotL
		if t > 0.02 then
			anyInFront = true
		end
		if t <= CONFIG.MaxShadowDistance * 2 then
			pts[#pts + 1] = worldToPlane2D(plane, c + lightDir * math.max(t, 0))
		end
	end
	if not anyInFront or #pts < 3 then
		return nil
	end
	local poly = computeConvexHull2D(pts)
	if #poly < 3 or math.abs(polygonSignedArea(poly)) < 1e-3 then
		return nil
	end
	return poly
end

-- Receiver area that is NOT already shadowed by the given occluders.
-- Returns a list of disjoint convex pieces and whether it is the untouched receiver.
local function computeVisiblePieces(plane, occluders, lightDir, region)
	local receiverPoly = getReceiverPolygon2D(plane)
	if region then
		-- Only the area that matters (a moving character's footprint): keeps the piece
		-- list small even on a huge floor.
		receiverPoly = clipPolygonToBox2D(receiverPoly, region.minU, region.maxU, region.minV, region.maxV)
		if #receiverPoly < 3 then
			return {}, true
		end
	end
	local pieces = { receiverPoly }
	local untouched = true
	if not occluders then
		return pieces, untouched
	end
	local rMinX, rMaxX, rMinY, rMaxY = polygonBounds2D(receiverPoly)
	local used = 0
	for _, occ in ipairs(occluders) do
		if used >= CONFIG.MaxOccludersPerPlane or #pieces == 0 or #pieces > 14 then
			break
		end
		if occ ~= plane.part and occ.Parent then
			local shadow = computeOccluderShadow2D(occ, plane, lightDir)
			if shadow then
				local sMinX, sMaxX, sMinY, sMaxY = polygonBounds2D(shadow)
				if sMaxX > rMinX and sMinX < rMaxX and sMaxY > rMinY and sMinY < rMaxY then
					used = used + 1
					local newPieces = {}
					for _, pc in ipairs(pieces) do
						local diff = subtractConvex2D(pc, shadow, 0.01)
						for _, d in ipairs(diff) do
							table.insert(newPieces, d)
						end
					end
					pieces = newPieces
					untouched = false
				end
			end
		end
	end
	return pieces, untouched
end

-- Clips one projection against the visible pieces and appends draw ops.
local function appendProjectionOps(ops, proj, pieces)
	local shape = proj.round and proj.outline or proj.poly
	if not shape or #shape < 3 then
		return
	end
	local sMinX, sMaxX, sMinY, sMaxY = polygonBounds2D(shape)
	for _, piece in ipairs(pieces) do
		local pMinX, pMaxX, pMinY, pMaxY = polygonBounds2D(piece)
		if sMaxX > pMinX and sMinX < pMaxX and sMaxY > pMinY and sMinY < pMaxY then
			if proj.round then
				local inside = true
				for i = 1, #shape do
					if not isPointInConvex2D(piece, shape[i], 1e-3) then
						inside = false
						break
					end
				end
				if inside then
					table.insert(ops.rounds, proj)
					return
				end
			end
			local clipped = clipPolygonByConvex2D(shape, piece)
			if #clipped >= 3 and math.abs(polygonSignedArea(clipped)) > 1e-3 then
				table.insert(ops.polys, clipped)
			end
		end
	end
end


-- Per-frame (dynamic layer) drawing for characters: tiles are looked up on demand.
local function drawOpsDynamic(plane, ops)
	for _, poly in ipairs(ops.polys) do
		local minU, maxU, minV, maxV = polygonBounds2D(poly)
		local tx0, tx1, ty0, ty1 = tileRangeForBounds(plane, minU, maxU, minV, maxV)
		if tx0 then
			for tx = tx0, tx1 do
				for ty = ty0, ty1 do
					local tile, pool = getDynamicTile(plane, tx, ty)
					if tile then
						drawConvexPolygonOnTile(poly, tile, pool)
					end
				end
			end
		end
	end
	for _, r in ipairs(ops.rounds) do
		local minU, maxU, minV, maxV = polygonBounds2D(r.outline)
		local tx0, tx1, ty0, ty1 = tileRangeForBounds(plane, minU, maxU, minV, maxV)
		if tx0 then
			for tx = tx0, tx1 do
				for ty = ty0, ty1 do
					local tile, pool = getDynamicTile(plane, tx, ty)
					if tile then
						drawRoundShadowOnTile(r, tile, pool)
					end
				end
			end
		end
	end
end

-- ============================================================================
-- EVENT-DRIVEN SCENE REGISTRY (no per-part connections: cheap on huge maps)
-- ============================================================================
local characterModels = {}
local globalRaycastIgnoreList = { shadowContainer }
-- Candidate map parts as parallel arrays (swap-remove). Position / size are cached so
-- scanning tens of thousands of parts costs table reads, not property reads.
local casterList = {}
local casterPos = {}         -- cached position (read live for unanchored parts)
local casterMag = {}         -- cached Size.Magnitude
local casterDyn = {}         -- true when the part is unanchored
local casterIndex = {}       -- part -> index
local casterVersion = 0      -- bumps whenever the set changes
local ignoreListDirty = true
local characterProfileDirty = setmetatable({}, { __mode = "k" })

local function addCaster(part, pos, mag, dyn)
	local idx = casterIndex[part]
	if not idx then
		idx = #casterList + 1
		casterList[idx] = part
		casterIndex[part] = idx
		casterVersion = casterVersion + 1
	end
	casterPos[idx] = pos
	casterMag[idx] = mag
	casterDyn[idx] = dyn
end

local function removeCaster(part)
	local idx = casterIndex[part]
	if idx then
		local last = #casterList
		local lastPart = casterList[last]
		casterList[idx] = lastPart
		casterPos[idx] = casterPos[last]
		casterMag[idx] = casterMag[last]
		casterDyn[idx] = casterDyn[last]
		casterIndex[lastPart] = idx
		casterList[last] = nil
		casterPos[last] = nil
		casterMag[last] = nil
		casterDyn[last] = nil
		casterIndex[part] = nil
		casterVersion = casterVersion + 1
	end
end

local function isActualCharacterModel(model)
	if not model or not model:IsA("Model") then
		return false
	end
	if model:FindFirstChildOfClass("Humanoid") == nil then
		return false
	end
	if model:FindFirstChild("Head") == nil
		and model:FindFirstChild("Torso") == nil
		and model:FindFirstChild("UpperTorso") == nil
		and model:FindFirstChild("HumanoidRootPart") == nil then
		return false
	end
	return #model:GetChildren() <= 80
end

local function rebuildGlobalIgnoreList()
	ignoreListDirty = false
	clearTable(globalRaycastIgnoreList)
	table.insert(globalRaycastIgnoreList, shadowContainer)
	for model in pairs(characterModels) do
		if model.Parent then
			table.insert(globalRaycastIgnoreList, model)
		end
	end
end

local function evaluateMapPartState(part)
	if (terrain and part == terrain) or part:IsDescendantOf(shadowContainer) then
		return
	end
	local s = part.Size
	if (s.X > CONFIG.MaxCasterPartSize or s.Z > CONFIG.MaxCasterPartSize) and s.Y < 15 then
		removeCaster(part)
		return
	end
	if s.X < CONFIG.MinCasterPartSize and s.Y < CONFIG.MinCasterPartSize and s.Z < CONFIG.MinCasterPartSize then
		removeCaster(part)
		return
	end
	-- Visibility (transparency, LocalTransparencyModifier) changes at runtime, so it is
	-- NOT decided here; the caster scan and the bake step check it live.
	addCaster(part, part.Position, s.Magnitude, not part.Anchored)
end

local function markCharacter(model)
	if not characterModels[model] then
		characterModels[model] = true
		ignoreListDirty = true
	end
	characterProfileDirty[model] = true
end

local function registerInstance(inst)
	if inst:IsDescendantOf(shadowContainer) then
		return
	end
	if inst:IsA("Humanoid") and inst.Parent and isActualCharacterModel(inst.Parent) then
		local charModel = inst.Parent
		markCharacter(charModel)
		for _, desc in ipairs(charModel:GetDescendants()) do
			if desc:IsA("BasePart") then
				removeCaster(desc)
				if CONFIG.ForceDisableNativeShadows and desc.CastShadow then
					desc.CastShadow = false
				end
			end
		end
	elseif inst:IsA("BasePart") then
		if terrain and inst == terrain then
			return
		end
		if CONFIG.ForceDisableNativeShadows and inst.CastShadow then
			inst.CastShadow = false
		end
		local anc = inst.Parent
		local hops = 0
		while anc and anc ~= Workspace and hops < 3 do
			hops = hops + 1
			if anc:IsA("Model") and (characterModels[anc] or isActualCharacterModel(anc)) then
				markCharacter(anc)
				removeCaster(inst)
				return
			end
			anc = anc.Parent
		end
		evaluateMapPartState(inst)
	end
end

local function unregisterInstance(inst)
	if inst:IsA("Model") then
		if characterModels[inst] then
			characterModels[inst] = nil
			ignoreListDirty = true
		end
	elseif inst:IsA("BasePart") then
		removeCaster(inst)
		local st = casterStates[inst]
		if st then
			removeCasterContribs(st)
			casterStates[inst] = nil
		end
	end
	-- Any change inside a character rebuilds its silhouette clone.
	local anc = inst.Parent
	local hops = 0
	while anc and anc ~= Workspace and hops < 4 do
		if characterModels[anc] then
			characterProfileDirty[anc] = true
			break
		end
		anc = anc.Parent
		hops = hops + 1
	end
end

-- Initial scan runs in slices so a huge map does not freeze the game on start.
do
	local all = Workspace:GetDescendants()
	local function scan()
		for i = 1, #all do
			pcall(registerInstance, all[i])
			if i % 1500 == 0 and task and task.wait then
				task.wait()
			end
		end
	end
	if task and task.spawn then
		task.spawn(scan)
	else
		scan()
	end
end

track(Workspace.DescendantAdded:Connect(function(inst)
	pcall(registerInstance, inst)
end))
track(Workspace.DescendantRemoving:Connect(function(inst)
	pcall(unregisterInstance, inst)
end))

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
pcall(function()
	rayParams.RespectCanCollide = false
end)

-- Parts that do not stop light (glass, fading doors, invisible triggers).
local function isRayPassable(inst)
	return inst ~= terrain and inst:IsA("BasePart") and not isPartOpaqueEnough(inst)
end

local lastErrorText = "-"
local reportError
do
	local reportedErrors = {}
	function reportError(tag, err)
		local msg = tag .. ": " .. tostring(err)
		lastErrorText = msg
		if not reportedErrors[msg] then
			reportedErrors[msg] = true
			warn("[StencilShadow " .. VERSION .. "] " .. msg)
		end
	end
end

-- ============================================================================
-- CHARACTER STATE (visible parts, sun visibility, appearance tracking)
-- ============================================================================
local charStates = setmetatable({}, { __mode = "k" })

local function shouldTrackCharacterPart(part)
	if part.Name == "HumanoidRootPart" then
		return false
	end
	local s = part.Size
	return s.X < 60 and s.Y < 60 and s.Z < 60
end

local function rebuildCharacterParts(state, model)
	clearTable(state.parts)
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") and shouldTrackCharacterPart(desc) then
			if CONFIG.ForceDisableNativeShadows and desc.CastShadow then
				desc.CastShadow = false
			end
			local info = state.partInfo[desc] or { part = desc, lit = 1, target = 1 }
			if info.isAcc == nil then
				info.isAcc = (desc:FindFirstAncestorWhichIsA("Accessory") ~= nil)
					or (desc:FindFirstAncestorWhichIsA("Tool") ~= nil)
			end
			table.insert(state.parts, info)
		end
	end
	local newInfo = {}
	for _, info in ipairs(state.parts) do
		newInfo[info.part] = info
	end
	state.partInfo = newInfo
	state.version = state.version + 1
	state.lastRebuild = wallNow()
	state.recv = nil
end

local function getCharacterState(model)
	local state = charStates[model]
	if not state then
		state = {
			model = model,
			parts = {},
			partInfo = {},
			version = 0,
			lastRebuild = -1e9,
			projectors = {},
			lastSeenFrame = 0,
			lastAllowedFrame = 0,
			recv = nil,
			recvFrame = -1000,
			recvPos = VEC3_ZERO,
			recvLight = VEC3_ZERO,
			floorTarget = 1,
			diag = {},
		}
		charStates[model] = state
		characterProfileDirty[model] = true
	end
	if characterProfileDirty[model] and (wallNow() - state.lastRebuild) > 0.2 then
		characterProfileDirty[model] = nil
		rebuildCharacterParts(state, model)
	end
	return state
end

local function isPartVisibleForShadow(part)
	return part.Parent ~= nil and part.Transparency < 0.98
end

-- Shading follows what the floor shows. refreshCharacterReceivers() decides whether the
-- spot a character stands on lies inside an already-baked shadow (state.floorTarget:
-- 0 = shaded, 1 = lit). Here we only smooth the change, so a part fades in and out of
-- shade without popping. (No per-part sun rays: cheaper, and never disagrees with the
-- shadows the player can see.)
local function updateCharacterLighting(state, dt)
	local alpha = 1 - math.exp(-CONFIG.SelfShadowFadeSpeed * dt)
	local target = state.floorTarget
	for _, info in ipairs(state.parts) do
		info.target = target
		local diff = target - info.lit
		if diff > 0.002 or diff < -0.002 then
			info.lit = info.lit + diff * alpha
		end
	end
end

-- ============================================================================
-- SELF-SHADOW HIGHLIGHTS (a character standing in shade is darkened)
-- ============================================================================
local queueSelfShadow, applySelfShadowHighlights
do
local highlightPool = {}
local highlightRequests = {}

local function getHighlight(index)
	local rec = highlightPool[index]
	if not rec then
		local h = Instance.new("Highlight")
		h.Name = "StencilSelfShadow"
		h.FillColor = CONFIG.ShadowColor
		h.FillTransparency = 1
		h.OutlineTransparency = 1
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Enabled = false
		h.Parent = shadowContainer
		rec = { inst = h, adornee = nil, fill = 1, enabled = false }
		highlightPool[index] = rec
	end
	return rec
end

function queueSelfShadow(state, distance)
	if not CONFIG.CharacterSelfShadow then
		return
	end
	local minShade, maxShade, sum, count = 1, 0, 0, 0
	for _, info in ipairs(state.parts) do
		if isPartVisibleForShadow(info.part) then
			local shade = 1 - info.lit
			if shade < minShade then minShade = shade end
			if shade > maxShade then maxShade = shade end
			sum = sum + shade
			count = count + 1
		end
	end
	if count == 0 or maxShade < 0.02 then
		return
	end
	table.insert(highlightRequests, {
		state = state,
		distance = distance,
		uniform = (maxShade - minShade) < 0.15,
		average = sum / count,
	})
end

function applySelfShadowHighlights()
	table.sort(highlightRequests, function(a, b)
		return a.distance < b.distance
	end)
	local used = 0
	local budget = math.min(math.max(2, math.floor(CONFIG.MaxSelfShadowHighlights * qualityLevel + 0.5)), 31)
	local strength = CONFIG.SelfShadowStrength * currentShadowStrength

	local function assign(adornee, shade)
		if used >= budget then
			return
		end
		used = used + 1
		local rec = getHighlight(used)
		local fill = 1 - math.clamp(shade, 0, 1) * strength
		if rec.adornee ~= adornee then
			rec.adornee = adornee
			rec.inst.Adornee = adornee
		end
		if math.abs(rec.fill - fill) > 0.004 then
			rec.fill = fill
			rec.inst.FillTransparency = fill
		end
		if not rec.enabled then
			rec.enabled = true
			rec.inst.Enabled = true
		end
	end

	for _, req in ipairs(highlightRequests) do
		local state = req.state
		local remaining = budget - used
		if remaining <= 0 then
			break
		end
		if req.uniform then
			assign(state.model, req.average)
		else
			local needed = 0
			for _, info in ipairs(state.parts) do
				if isPartVisibleForShadow(info.part) and (1 - info.lit) > 0.02 then
					needed = needed + 1
				end
			end
			if needed <= remaining - 1 then
				for _, info in ipairs(state.parts) do
					if isPartVisibleForShadow(info.part) and (1 - info.lit) > 0.02 then
						assign(info.part, 1 - info.lit)
					end
				end
			else
				assign(state.model, req.average)
			end
		end
	end

	for i = used + 1, #highlightPool do
		local rec = highlightPool[i]
		if rec.enabled then
			rec.enabled = false
			rec.inst.Enabled = false
			rec.adornee = nil
			rec.inst.Adornee = nil
		end
	end
	clearTable(highlightRequests)
end
end

-- ============================================================================
-- EXACT CHARACTER SILHOUETTES (ViewportFrame projected along the light)
-- ============================================================================
-- The character is mirrored into a black ViewportFrame whose camera looks down
-- the light direction (near-orthographic). Projecting that image onto a surface
-- is exact when the image is stretched by k = 1/cos(incidence) along the
-- direction the light slopes across the surface. A SurfaceGui whose canvas
-- aspect differs from its carrier part's face performs exactly that stretch.
local allProjectors = {}

local function createProjector()
	local part = Instance.new("Part")
	part.Name = "StencilSilhouette"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 0.01)
	part.CFrame = CFrame.new(0, -5000, 0)

	local sgui = Instance.new("SurfaceGui")
	sgui.Name = "SilhouetteSurfaceGui"
	sgui.Face = Enum.NormalId.Front
	sgui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sgui.CanvasSize = Vector2.new(64, 64)
	sgui.LightInfluence = 0
	sgui.Brightness = 1
	sgui.ClipsDescendants = true
	sgui.ResetOnSpawn = false
	sgui.ZOffset = 2
	sgui.Enabled = false
	pcall(function()
		sgui.MaxDistance = 100000
	end)
	sgui.Adornee = part
	sgui.Parent = part

	if CONFIG.DebugSilhouette then
		-- Shows WHERE the silhouette is placed even if the 3D content fails to render.
		local back = Instance.new("Frame")
		back.Name = "DebugBack"
		back.BackgroundColor3 = Color3.fromRGB(255, 0, 255)
		back.BackgroundTransparency = 0.55
		back.BorderSizePixel = 0
		back.Size = UDim2.new(1, 0, 1, 0)
		back.ZIndex = 0
		back.Parent = sgui
	end

	local vpf = Instance.new("ViewportFrame")
	vpf.Name = "Silhouette"
	vpf.ZIndex = 2
	vpf.BackgroundTransparency = 1
	vpf.BorderSizePixel = 0
	vpf.AnchorPoint = Vector2.new(0, 0)
	local dbg = CONFIG.DebugSilhouette
	vpf.Ambient = dbg and Color3.fromRGB(255, 70, 70) or Color3.new(0, 0, 0)
	vpf.LightColor = dbg and Color3.fromRGB(255, 70, 70) or Color3.new(0, 0, 0)
	vpf.ImageColor3 = dbg and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
	vpf.ImageTransparency = dbg and 0.2 or currentGroupTransparency
	vpf.Parent = sgui

	local world = Instance.new("WorldModel")
	world.Parent = vpf

	local cam = Instance.new("Camera")
	cam.FieldOfView = CONFIG.SilhouetteFieldOfView
	cam.Parent = vpf
	vpf.CurrentCamera = cam

	part.Parent = shadowContainer

	local proj = {
		carrier = part,
		sgui = sgui,
		vpf = vpf,
		world = world,
		camera = cam,
		clones = {},
		moveParts = {},
		moveCFrames = {},
		cloneVersion = -1,
		enabled = false,
		imageTransparency = currentGroupTransparency,
		lastCF = nil, lastSize = nil, lastCanvas = nil,
		lastVpPos = nil, lastVpSize = nil, lastCamCF = nil,
	}
	table.insert(allProjectors, proj)
	return proj
end

local function destroyProjector(proj)
	for i = #allProjectors, 1, -1 do
		if allProjectors[i] == proj then
			table.remove(allProjectors, i)
		end
	end
	pcall(function()
		proj.carrier:Destroy()
	end)
end

local function cloneVisualPart(src)
	pcall(function()
		src.Archivable = true
	end)
	local ok, clone = pcall(function()
		return src:Clone()
	end)
	if not ok or not clone then
		return nil
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if not (d:IsA("DataModelMesh") or d:IsA("SurfaceAppearance") or d:IsA("Decal")) then
			pcall(function()
				d:Destroy()
			end)
		end
	end
	pcall(function()
		clone.Anchored = true
		clone.CanCollide = false
		clone.CanTouch = false
		clone.CanQuery = false
		clone.CastShadow = false
	end)
	return clone
end

local function buildProjectorClones(proj, state)
	pcall(function()
		proj.world:ClearAllChildren()
	end)
	clearTable(proj.clones)
	clearTable(proj.moveParts)
	clearTable(proj.moveCFrames)

	local holder = Instance.new("Model")
	holder.Name = "SilhouetteClone"
	for _, info in ipairs(state.parts) do
		local clone = cloneVisualPart(info.part)
		if clone then
			clone.Parent = holder
			table.insert(proj.clones, { src = info.part, clone = clone, info = info, transparency = clone.Transparency })
		end
	end

	-- Classic R6 packages are CharacterMeshes, which need a Humanoid to apply.
	local hasCharacterMesh = false
	for _, child in ipairs(state.model:GetChildren()) do
		if child:IsA("CharacterMesh") then
			local ok, cm = pcall(function()
				child.Archivable = true
				return child:Clone()
			end)
			if ok and cm then
				cm.Parent = holder
				hasCharacterMesh = true
			end
		end
	end
	if hasCharacterMesh then
		pcall(function()
			local hum = Instance.new("Humanoid")
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.Parent = holder
		end)
	end

	holder.Parent = proj.world
	proj.cloneVersion = state.version
end

-- Copies the live pose and per-part sun visibility onto the clone.
local function updateProjectorPose(proj)
	local parts, cframes = proj.moveParts, proj.moveCFrames
	local count = 0
	for _, c in ipairs(proj.clones) do
		local src = c.src
		if src.Parent then
			local srcTr = math.clamp(src.Transparency, 0, 1)
			local tr = 1 - (1 - srcTr) * math.clamp(c.info.lit, 0, 1)
			if srcTr >= 0.98 or tr > 0.97 then
				tr = 1
			end
			if math.abs(c.transparency - tr) > 0.02 then
				c.transparency = tr
				c.clone.Transparency = tr
			end
			count = count + 1
			parts[count] = c.clone
			cframes[count] = src.CFrame
		elseif c.transparency ~= 1 then
			c.transparency = 1
			c.clone.Transparency = 1
		end
	end
	for i = count + 1, #parts do
		parts[i] = nil
		cframes[i] = nil
	end
	local ok = pcall(function()
		proj.world:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for i = 1, count do
			parts[i].CFrame = cframes[i]
		end
	end
end

local function setProjectorEnabled(proj, enabled)
	if proj.enabled ~= enabled then
		proj.enabled = enabled
		proj.sgui.Enabled = enabled
		if not enabled then
			proj.lastCF = CFrame.new(0, -5000, 0)
			proj.carrier.CFrame = proj.lastCF
		end
	end
end

-- Orthonormal light frame for a receiver plane.
--   R  = image right  (lies in the plane)
--   U  = image up     (perpendicular to the light)
--   Yp = in-plane direction U lands on; k = stretch along Yp (= 1/cos)
local function computeLightFrame(plane, lightDir)
	local n = plane.normal
	local nDotL = n:Dot(lightDir)
	if -nDotL < 0.12 then
		return nil
	end
	local perp = n - lightDir * nDotL
	local U
	if perp.Magnitude > 1e-3 then
		U = perp.Unit
	else
		local t = plane.tangentV - lightDir * plane.tangentV:Dot(lightDir)
		U = t.Unit
	end
	local R = lightDir:Cross(U).Unit
	local Uprime = U - lightDir * (U:Dot(n) / nDotL)
	local k = Uprime.Magnitude
	return { U = U, R = R, Yp = Uprime / k, k = k, nDotL = nDotL }
end

local function getVisualRadius(part)
	local size = part.Size
	local sp = part:FindFirstChildOfClass("SpecialMesh")
	if sp then
		local scaled = size * sp.Scale
		size = Vector3.new(math.max(size.X, scaled.X), math.max(size.Y, scaled.Y), math.max(size.Z, scaled.Z)) * 1.15
		return size.Magnitude * 0.5 + sp.Offset.Magnitude
	end
	return size.Magnitude * 0.5
end

-- Light-view bounds of the visible, sunlit parts around `ref`.
local function computeSilhouetteBounds(state, lf, ref)
	local s0, s1, r0, r1 = math.huge, -math.huge, math.huge, -math.huge
	local any = false
	for _, info in ipairs(state.parts) do
		local part = info.part
		if info.lit > 0.03 and isPartVisibleForShadow(part) then
			local rel = part.Position - ref
			local s = rel:Dot(lf.R)
			local r = rel:Dot(lf.U)
			local rad = info.radius or getVisualRadius(part)
			info.radius = rad
			if s - rad < s0 then s0 = s - rad end
			if s + rad > s1 then s1 = s + rad end
			if r - rad < r0 then r0 = r - rad end
			if r + rad > r1 then r1 = r + rad end
			any = true
		end
	end
	if not any then
		return nil
	end
	local m = 0.2
	return s0 - m, s1 + m, r0 - m, r1 + m
end

local function placeProjector(proj, plane, lf, lightDir, Pc, Cc, a, b, x0, x1, y0, y1, pps)
	local k = lf.k
	local w = math.max(x1 - x0, 0.05)
	local h = math.max(y1 - y0, 0.05)
	pps = math.min(pps, CONFIG.MaxCanvasPixels / math.max(w, a), CONFIG.MaxCanvasPixels * k / math.max(h, k * b))

	local center = Pc + lf.R * ((x0 + x1) * 0.5) + lf.Yp * ((y0 + y1) * 0.5)
		+ plane.normal * (CONFIG.SurfaceOffset + 0.012)
	local cf = CFrame.fromMatrix(center, -lf.R, lf.Yp, -plane.normal)
	local size = Vector3.new(w, h, 0.01)
	local canvas = Vector2.new(w * pps, h * pps / k)
	local vpPos = UDim2.new(0, (-a * 0.5 - x0) * pps, 0, (y1 - k * b * 0.5) * pps / k)
	local vpSize = UDim2.new(0, a * pps, 0, b * pps)
	local dist = (b * 0.5) / math.tan(math.rad(CONFIG.SilhouetteFieldOfView) * 0.5)
	local camFrame = CFrame.fromMatrix(Cc - lightDir * dist, lf.R, lf.U, -lightDir)

	if proj.lastSize ~= size then
		proj.lastSize = size
		proj.carrier.Size = size
	end
	if proj.lastCF ~= cf then
		proj.lastCF = cf
		proj.carrier.CFrame = cf
	end
	if proj.lastCanvas ~= canvas then
		proj.lastCanvas = canvas
		proj.sgui.CanvasSize = canvas
	end
	if proj.lastVpPos ~= vpPos then
		proj.lastVpPos = vpPos
		proj.vpf.Position = vpPos
	end
	if proj.lastVpSize ~= vpSize then
		proj.lastVpSize = vpSize
		proj.vpf.Size = vpSize
	end
	if proj.lastCamCF ~= camFrame then
		proj.lastCamCF = camFrame
		proj.camera.CFrame = camFrame
	end
	if not CONFIG.DebugSilhouette and math.abs(proj.imageTransparency - currentGroupTransparency) > 0.003 then
		proj.imageTransparency = currentGroupTransparency
		proj.vpf.ImageTransparency = currentGroupTransparency
	end
	setProjectorEnabled(proj, true)
end


-- Cached local visual box of a tracked part (mesh scale / offset never change).
local function getInfoBox(info)
	local off = info.vbOff
	if not off then
		off, info.vbSize = getPartVisualBoxLocal(info.part)
		info.vbOff = off
	end
	return off, info.vbSize
end

local function partApproxHull(info, scale)
	local part = info.part
	local off, size = getInfoBox(info)
	local cf = part.CFrame
	if off.X ~= 0 or off.Y ~= 0 or off.Z ~= 0 then
		cf = cf * CFrame.new(off)
	end
	scale = scale or 1
	if part.Name == "Head" then
		return makeEllipsoidHull(part, cf, size * (0.5 * scale))
	end
	return makeBoxHull(part, cf, size * (0.95 * scale))
end

-- Limb chains (upper arm + lower arm + hand ...) are merged into one outline so the
-- fallback costs ~8 polygons instead of ~20 per character.
local function groupKeyFor(info)
	local key = info.groupKey
	if key then
		return key
	end
	local name = info.part.Name
	key = info.part
	if name == "Head" then
		key = "Head"
	elseif string.find(name, "Torso", 1, true) then
		key = "Torso"
	else
		local left = string.find(name, "Left", 1, true) ~= nil
		local right = string.find(name, "Right", 1, true) ~= nil
		if left or right then
			local side = left and "L" or "R"
			if string.find(name, "Arm", 1, true) or string.find(name, "Hand", 1, true) then
				key = side .. "Arm"
			elseif string.find(name, "Leg", 1, true) or string.find(name, "Foot", 1, true) then
				key = side .. "Leg"
			end
		end
	end
	info.groupKey = key
	return key
end

local approxGroupPts = {}
local approxGroupOrder = {}

-- Per-part approximation: heads are ellipsoids, everything else is its real
-- oriented box. Used for the slivers an exact silhouette cannot cover and for
-- close characters that did not get a silhouette.
local function drawApproximateCharacter(state, plane, lightDir, pieces, scale, bodyOnly)
	for _, info in ipairs(state.parts) do
		if info.lit > 0.5 and isPartVisibleForShadow(info.part) and not (bodyOnly and info.isAcc) then
			local proj = computeHullProjection(partApproxHull(info, scale), lightDir, plane)
			if proj and proj.poly then
				local key = groupKeyFor(info)
				local list = approxGroupPts[key]
				if not list then
					list = {}
					approxGroupPts[key] = list
					approxGroupOrder[#approxGroupOrder + 1] = key
				end
				for _, p in ipairs(proj.poly) do
					list[#list + 1] = p
				end
			end
		end
	end
	local ops = { polys = {}, rounds = {} }
	for i = 1, #approxGroupOrder do
		local key = approxGroupOrder[i]
		local list = approxGroupPts[key]
		if #list >= 3 then
			local poly = computeConvexHull2D(list)
			if #poly >= 3 then
				appendProjectionOps(ops, { plane = plane, poly = poly, round = false }, pieces)
			end
		end
		approxGroupPts[key] = nil
		approxGroupOrder[i] = nil
	end
	drawOpsDynamic(plane, ops)
end

-- One merged outline for distant characters (a handful of primitives).
local function drawMergedCharacterHull(state, plane, lightDir, pieces)
	local n = plane.normal
	local nDotL = n:Dot(lightDir)
	if nDotL >= -0.03 then
		return
	end
	local pts = {}
	for _, info in ipairs(state.parts) do
		local part = info.part
		if info.lit > 0.5 and isPartVisibleForShadow(part) then
			local p = part.Position
			local t = (plane.origin - p):Dot(n) / nDotL
			if t >= -0.35 and t <= CONFIG.MaxShadowDistance then
				local r = info.radius
				if not r then
					r = getVisualRadius(part)
					info.radius = r
				end
				r = r * 0.55
				local c = worldToPlane2D(plane, p + lightDir * math.max(t, 0))
				for k = 0, 5 do
					local a = k * (math.pi / 3)
					pts[#pts + 1] = Vector2.new(c.X + math.cos(a) * r, c.Y + math.sin(a) * r)
				end
			end
		end
	end
	if #pts < 3 then
		return
	end
	local poly = computeConvexHull2D(pts)
	if #poly < 3 then
		return
	end
	local ops = { polys = {}, rounds = {} }
	appendProjectionOps(ops, { plane = plane, poly = poly, round = false }, pieces)
	drawOpsDynamic(plane, ops)
end

local function toFootprint(plane, Pc, lf, uv)
	local w = planeToWorld(plane, uv) - Pc
	return Vector2.new(w:Dot(lf.R), w:Dot(lf.Yp))
end

local function fromFootprint(plane, Pc, lf, xy)
	return worldToPlane2D(plane, Pc + lf.R * xy.X + lf.Yp * xy.Y)
end

-- Finds the surfaces the character's shadow falls on (first hit per body part
-- along the light) and every surface that blocks the light in between.
local function discoverCharacterReceivers(state, lightDir, maxRays)
	local planes, counts, order = {}, {}, {}
	local occluders, occluderSet = {}, {}
	local rays = 0
	local rayVec = lightDir * CONFIG.MaxShadowDistance
	for _, info in ipairs(state.parts) do
		if rays >= maxRays then
			break
		end
		local part = info.part
		if isPartVisibleForShadow(part) then
			rays = rays + 1
			local origin = part.Position
			local hit = Workspace:Raycast(origin, rayVec, rayParams)
			local hops = 0
			while hit do
				local inst = hit.Instance
				if not occluderSet[inst] and not isRayPassable(inst) then
					occluderSet[inst] = true
					table.insert(occluders, inst)
				end
				local plane = extractReceiverPlane(inst, hit.Normal, hit.Position, CONFIG.MinReceiverFaceSize)
				if plane then
					local key = plane.baseKey
					if not planes[key] then
						planes[key] = plane
						counts[key] = 0
						table.insert(order, key)
					end
					counts[key] = counts[key] + 1
					break
				end
				hops = hops + 1
				if hops > 2 then
					break
				end
				local resume = hit.Position + lightDir * 0.3
				local remaining = CONFIG.MaxShadowDistance - (resume - origin).Magnitude
				if remaining <= 1 then
					break
				end
				hit = Workspace:Raycast(resume, lightDir * remaining, rayParams)
			end
		end
	end
	table.sort(order, function(x, y)
		return counts[x] > counts[y]
	end)
	local result = {}
	for _, key in ipairs(order) do
		table.insert(result, planes[key])
	end
	return result, occluders
end

local function renderCharacterOnPlane(state, plane, pieces, lightDir, proj, pps)
	if #pieces == 0 then
		return false
	end
	if not proj then
		drawApproximateCharacter(state, plane, lightDir, pieces)
		return false
	end

	local lf = computeLightFrame(plane, lightDir)
	if not lf then
		return false
	end
	local ref = state.root.Position
	local s0, s1, r0, r1 = computeSilhouetteBounds(state, lf, ref)
	if not s0 then
		return false
	end
	local a, b = s1 - s0, r1 - r0
	local Cc = ref + lf.R * ((s0 + s1) * 0.5) + lf.U * ((r0 + r1) * 0.5)
	local t = (plane.origin - Cc):Dot(plane.normal) / lf.nDotL
	if t < -2 or t > CONFIG.MaxShadowDistance then
		return false
	end
	local Pc = Cc + lightDir * t
	local halfA, halfKB = a * 0.5, lf.k * b * 0.5
	local footArea = a * lf.k * b

	-- Visible pieces in footprint coordinates, clipped to the footprint.
	local fpPieces = {}
	local coveredArea = 0
	for _, piece in ipairs(pieces) do
		local conv = {}
		for i = 1, #piece do
			conv[i] = toFootprint(plane, Pc, lf, piece[i])
		end
		local clipped = clipPolygonToBox2D(conv, -halfA, halfA, -halfKB, halfKB)
		if #clipped >= 3 then
			local area = math.abs(polygonSignedArea(clipped))
			if area > 1e-3 then
				table.insert(fpPieces, { poly = clipped, area = area })
				coveredArea = coveredArea + area
			end
		end
	end
	if #fpPieces == 0 then
		return false
	end

	local x0, x1, y0, y1 = -halfA, halfA, -halfKB, halfKB
	local chosen = nil
	if not (#fpPieces == 1 and coveredArea >= footArea * 0.998) then
		table.sort(fpPieces, function(p, q)
			return p.area > q.area
		end)
		local bestArea = 0
		for i = 1, math.min(3, #fpPieces) do
			local bx0, bx1, by0, by1, area = largestInscribedAxisRect2D(fpPieces[i].poly)
			if bx0 and area > bestArea then
				bestArea = area
				chosen = i
				x0, x1, y0, y1 = bx0, bx1, by0, by1
			end
		end
		if not chosen or bestArea < 0.02 then
			setProjectorEnabled(proj, false)
			drawApproximateCharacter(state, plane, lightDir, pieces)
			return false
		end
	end

	if proj.cloneVersion ~= state.version then
		buildProjectorClones(proj, state)
	end
	updateProjectorPose(proj)
	placeProjector(proj, plane, lf, lightDir, Pc, Cc, a, b, x0, x1, y0, y1, pps)

	-- Slivers outside the exact rectangle get the approximate silhouette.
	if chosen then
		local rest = {}
		local rectPoly = rectPolygon2D(x0, x1, y0, y1)
		for i, fp in ipairs(fpPieces) do
			local parts = (i == chosen) and subtractConvex2D(fp.poly, rectPoly, 0.01) or { fp.poly }
			for _, poly in ipairs(parts) do
				local uvPoly = {}
				for j = 1, #poly do
					uvPoly[j] = fromFootprint(plane, Pc, lf, poly[j])
				end
				table.insert(rest, ensureCCW(uvPoly))
			end
		end
		if #rest > 0 then
			drawApproximateCharacter(state, plane, lightDir, rest)
		end
	end
	return true
end

local silhouetteAnnounced = false

-- Removes `statics` (shadow polygons already painted on the surface) from `pieces`.
local function subtractStaticPolys(pieces, statics)
	local used = 0
	for _, poly in ipairs(statics) do
		if #pieces == 0 or #pieces > 20 or used >= 14 then
			break
		end
		local pa, pb, pc, pd = polygonBounds2D(poly)
		local sub = ensureCCW(poly)
		local newPieces = {}
		for _, pcPiece in ipairs(pieces) do
			local a, b, c, d = polygonBounds2D(pcPiece)
			if b >= pa and a <= pb and d >= pc and c <= pd then
				for _, diff in ipairs(subtractConvex2D(pcPiece, sub, 0.01)) do
					newPieces[#newPieces + 1] = diff
				end
			else
				newPieces[#newPieces + 1] = pcPiece
			end
		end
		pieces = newPieces
		used = used + 1
	end
	return pieces
end

-- Surfaces the shadow lands on + what is still unshaded there. Cached for a few frames:
-- the set of surfaces under a walking character barely changes.
--
-- STENCIL SEMANTICS: the character's shadow volume is intersected with the part of the
-- surface that is not already in shadow. "Already in shadow" is read from the baked
-- static layer (the polygons the player can actually see), so a character walking into a
-- building's shadow merges with it: nothing is darkened twice and no gap appears.
local function refreshCharacterReceivers(state, lightDir, maxRays)
	local planes, occluders = discoverCharacterReceivers(state, lightDir, maxRays)
	local rootPos = state.root.Position
	local list = {}
	local haveFloor, floorShaded = false, false
	local nStatics = 0
	for i = 1, math.min(#planes, 4) do
		local plane = planes[i]
		local nDotL = plane.normal:Dot(lightDir)
		if nDotL < -0.03 then
			-- Footprint of the whole character on this surface (plane space, padded).
			local minU, maxU, minV, maxV = math.huge, -math.huge, math.huge, -math.huge
			for _, info in ipairs(state.parts) do
				local part = info.part
				if isPartVisibleForShadow(part) then
					local p = part.Position
					local t = (plane.origin - p):Dot(plane.normal) / nDotL
					local uv = worldToPlane2D(plane, p + lightDir * math.max(t, 0))
					local r = info.radius
					if not r then
						r = getVisualRadius(part)
						info.radius = r
					end
					if uv.X - r < minU then minU = uv.X - r end
					if uv.X + r > maxU then maxU = uv.X + r end
					if uv.Y - r < minV then minV = uv.Y - r end
					if uv.Y + r > maxV then maxV = uv.Y + r end
				end
			end
			if minU < maxU then
				local pad = 3
				local region = { minU = minU - pad, maxU = maxU + pad, minV = minV - pad, maxV = maxV + pad }
				local statics = {}
				collectStaticShadowPolys(plane, region.minU, region.maxU, region.minV, region.maxV, statics, {})
				nStatics = nStatics + #statics
				if i == 1 then
					haveFloor = true
					local rootUV = worldToPlane2D(plane, rootPos)
					for _, poly in ipairs(statics) do
						if isPointInConvex2D(ensureCCW(poly), rootUV, 0.05) then
							floorShaded = true
							break
						end
					end
				end
				local pieces = computeVisiblePieces(plane, occluders, lightDir, region)
				if #pieces > 0 then
					pieces = subtractStaticPolys(pieces, statics)
				end
				if #pieces > 0 then
					list[#list + 1] = { plane = plane, pieces = pieces }
				end
			end
		end
	end
	state.floorTarget = (haveFloor and floorShaded) and 0 or 1
	state.recv = list
	state.recvFrame = frameCounter
	state.recvPos = rootPos
	state.recvLight = lightDir
	local dg = state.diag
	dg.planes = #planes
	dg.usable = #list
	dg.statics = nStatics
	dg.haveFloor = haveFloor
	dg.floorShaded = floorShaded
	dg.floorPart = (planes[1] and planes[1].part and planes[1].part.Name) or "-"
end

local usedProjectorScratch = {}
local function renderCharacterShadow(state, lightDir, distance, allowSilhouette, isLocal)
	local baseInterval = isLocal and CONFIG.LocalReceiverInterval or CONFIG.OtherReceiverInterval
	local interval = math.max(1, math.floor(baseInterval / qualityLevel + 0.5))
	local recv = state.recv
	if not recv
		or frameCounter - state.recvFrame >= interval
		or (state.root.Position - state.recvPos).Magnitude > 1.5
		or (state.recvLight - lightDir).Magnitude > 0.003 then
		refreshCharacterReceivers(state, lightDir, (distance < CONFIG.SilhouetteDistance) and 24 or 6)
		recv = state.recv
	end

	local maxSilPlanes = isLocal and CONFIG.MaxSilhouettePlanes + 1 or math.max(1, CONFIG.MaxSilhouettePlanes - 1)
	if qualityLevel < 0.6 then
		maxSilPlanes = 1
	end
	local nearApprox = distance <= CONFIG.FarHullDistance * qualityLevel
	clearTable(usedProjectorScratch)
	local dg = state.diag
	dg.silAllowed = allowSilhouette
	dg.silPlaced = 0
	dg.core = false

	for idx, rp in ipairs(recv) do
		local plane = rp.plane
		local proj = nil
		if allowSilhouette and idx <= maxSilPlanes then
			proj = state.projectors[idx]
			if not proj then
				proj = createProjector()
				state.projectors[idx] = proj
				if not silhouetteAnnounced then
					silhouetteAnnounced = true
					print("[StencilShadow " .. VERSION .. "] exact player silhouette active (set DebugSilhouette = true to see it in red)")
				end
			end
		end
		if proj then
			local pps = CONFIG.SilhouettePixelsPerStud * CONFIG.LodNearDistance
				/ math.max((plane.origin - camPos).Magnitude, CONFIG.LodNearDistance)
			pps = math.max(pps, 8)
			local ok, used = pcall(renderCharacterOnPlane, state, plane, rp.pieces, lightDir, proj, pps)
			if not ok then
				reportError("silhouette", used)
			elseif used then
				usedProjectorScratch[idx] = true
				dg.silPlaced = dg.silPlaced + 1
			end
			-- Safety net for YOUR character: a slightly shrunken outline of the real parts is
			-- always drawn under the exact silhouette. If the silhouette renders it is hidden
			-- inside it; if the device cannot render the ViewportFrame it is still a shadow.
			if isLocal and CONFIG.LocalPlayerCore and qualityLevel >= 0.5 then
				drawApproximateCharacter(state, plane, lightDir, rp.pieces, 0.82, true)
				dg.core = true
			end
		elseif nearApprox then
			drawApproximateCharacter(state, plane, lightDir, rp.pieces)
		else
			drawMergedCharacterHull(state, plane, lightDir, rp.pieces)
		end
	end
	for idx, proj in pairs(state.projectors) do
		if not usedProjectorScratch[idx] then
			setProjectorEnabled(proj, false)
		end
	end
end

-- ============================================================================
-- MAP CASTERS: sliced scan -> nearest-first budgeted bake -> retained tiles
-- ============================================================================
local nearbyList = {}
local nearbySet = {}
local bakeCursor = 1
local lightEpoch = 0
local bakedLightDir = nil
local DOWN_PROBE_VEC = Vector3.new(0, -160, 0)
local scan = { active = false, cursor = 1, focus = Vector3.new(0, -1e6, 0), lastEnd = -1e9, version = -1 }

local function getCasterProbePoints(hull, near)
	local pts = { hull.center }
	if not near then
		return pts
	end
	if hull.shapeType == "Box" and hull.verts and #hull.verts == 8 then
		for _, idx in ipairs({ 3, 4, 7, 8 }) do
			local v = hull.verts[idx]
			pts[#pts + 1] = v + (hull.center - v) * 0.08
		end
	elseif hull.endPoint1 and hull.endPoint2 and hull.endPoint1 ~= hull.endPoint2 then
		pts[#pts + 1] = hull.endPoint1
		pts[#pts + 1] = hull.endPoint2
	end
	return pts
end

-- Walks a ray, skipping the caster itself, glass and slivers too small to receive.
local function castThrough(origin, direction, caster, occluders, occluderSet)
	local remaining = direction.Magnitude
	local dirUnit = direction / remaining
	local o = origin
	for _ = 1, 5 do
		local hit = Workspace:Raycast(o, dirUnit * remaining, rayParams)
		if not hit then
			return nil
		end
		local inst = hit.Instance
		if inst ~= caster and not isRayPassable(inst) then
			if not occluderSet[inst] then
				occluderSet[inst] = true
				occluders[#occluders + 1] = inst
			end
			local small = inst ~= terrain
				and math.max(inst.Size.X, inst.Size.Y, inst.Size.Z) < CONFIG.MinMapReceiverFaceSize
			if not small then
				return hit
			end
		end
		local step = (hit.Position - o).Magnitude + 0.3
		remaining = remaining - step
		if remaining <= 0.5 then
			return nil
		end
		o = o + dirUnit * step
	end
	return nil
end

local function bakeMapCaster(part, lightDir, dist)
	local hull = extractMapPartHull(part)
	local near = dist < 400
	local planes, seen = {}, {}
	local occluders, occluderSet = {}, {}
	local maxPlanes = near and 7 or 4

	local function addPlane(plane)
		if plane and #planes < maxPlanes and not seen[plane.baseKey] and plane.part ~= part then
			seen[plane.baseKey] = true
			planes[#planes + 1] = plane
		end
	end

	if near then
		local downHit = castThrough(hull.center, DOWN_PROBE_VEC, part, {}, {})
		if downHit then
			addPlane(extractReceiverPlane(downHit.Instance, downHit.Normal, downHit.Position, CONFIG.MinMapReceiverFaceSize))
		end
	end

	local rayVec = lightDir * CONFIG.MaxShadowDistance
	for _, origin in ipairs(getCasterProbePoints(hull, near)) do
		local hit = castThrough(origin, rayVec, part, occluders, occluderSet)
		if hit then
			addPlane(extractReceiverPlane(hit.Instance, hit.Normal, hit.Position, CONFIG.MinMapReceiverFaceSize))
		end
	end

	local entries = {}
	local reverse = near and part.Anchored
	local idx = 1
	while idx <= #planes do
		local plane = planes[idx]
		idx = idx + 1
		local proj = computeHullProjection(hull, lightDir, plane)
		if proj then
			local planeOccluders, planeSet = {}, {}
			for _, o in ipairs(occluders) do
				planeSet[o] = true
				planeOccluders[#planeOccluders + 1] = o
			end

			-- Look back towards the sun from the shadow footprint: anything in
			-- between already shades that area (walls, roofs, floors above).
			if reverse then
				local shape = proj.round and proj.outline or proj.poly
				if shape and #shape >= 3 then
					local cu, cv = 0, 0
					for i = 1, #shape do
						cu = cu + shape[i].X
						cv = cv + shape[i].Y
					end
					local centroid = Vector2.new(cu / #shape, cv / #shape)
					local mid = math.floor(#shape / 2) + 1
					local samples = {
						centroid,
						shape[1] + (centroid - shape[1]) * 0.1,
						shape[mid] + (centroid - shape[mid]) * 0.1,
					}
					for _, uv in ipairs(samples) do
						if math.abs(uv.X) <= plane.halfU and math.abs(uv.Y) <= plane.halfV then
							local p = planeToWorld(plane, uv) + plane.normal * 0.05
							local back = (p - hull.center):Dot(lightDir) - 0.1
							if back > 0.3 then
								local hit = castThrough(p, -lightDir * back, part, planeOccluders, planeSet)
								if hit then
									addPlane(extractReceiverPlane(hit.Instance, hit.Normal, hit.Position, CONFIG.MinMapReceiverFaceSize))
								end
							end
						end
					end
				end
			end

			local pieces = computeVisiblePieces(plane, planeOccluders, lightDir)
			if #pieces > 0 then
				local ops = { polys = {}, rounds = {} }
				appendProjectionOps(ops, proj, pieces)
				if #ops.polys > 0 or #ops.rounds > 0 then
					entries[#entries + 1] = { plane = plane, ops = ops }
				end
			end
		end
	end
	return entries
end

local function bakeCaster(part, st, lightDir, now)
	if not st then
		st = { part = part, tiles = {} }
		casterStates[part] = st
	end
	local dist = (part.Position - camPos).Magnitude
	local ok, entries = pcall(bakeMapCaster, part, lightDir, dist)
	if not ok then
		reportError("bake", entries)
		entries = {}
	end
	removeCasterContribs(st)
	st.cf = part.CFrame
	st.size = part.Size
	local cidx = casterIndex[part]
	if cidx then
		casterPos[cidx] = part.Position
	end
	st.epoch = lightEpoch
	st.bakedAt = now
	st.dynamic = not part.Anchored
	for _, e in ipairs(entries) do
		addEntryToTiles(st, e)
	end
end

local stepCasterScan, stepMapBaking
do
-- ----------------------------------------------------------------------------
-- Nearest-K selection with a bounded max-heap: no sorting of thousands of parts and
-- no per-candidate table allocation (both showed up as hitches on a phone).
-- ----------------------------------------------------------------------------
local heapKey, heapD, heapP, heapN, heapK = {}, {}, {}, 0, 0

-- Max-heap on `key` (smaller key = more important). Each entry also carries its true
-- distance `sd` (used to order baking) and the part.
local function heapPush(key, sd, part)
	if heapN < heapK then
		heapN = heapN + 1
		local i = heapN
		while i > 1 do
			local p = math.floor(i / 2)
			if heapKey[p] >= key then
				break
			end
			heapKey[i], heapD[i], heapP[i] = heapKey[p], heapD[p], heapP[p]
			i = p
		end
		heapKey[i], heapD[i], heapP[i] = key, sd, part
	elseif key < heapKey[1] then
		local i = 1
		while true do
			local l = i * 2
			if l > heapN then
				break
			end
			local c = l
			if l + 1 <= heapN and heapKey[l + 1] > heapKey[l] then
				c = l + 1
			end
			if heapKey[c] <= key then
				break
			end
			heapKey[i], heapD[i], heapP[i] = heapKey[c], heapD[c], heapP[c]
			i = c
		end
		heapKey[i], heapD[i], heapP[i] = key, sd, part
	end
end

local RING_EDGES = { 40, 80, 160, 320, 640, 1280, 2560 }

local function finishCasterScan()
	-- Bucket the K nearest by distance ring so baking goes roughly nearest-first.
	local rings = {}
	for i = 1, #RING_EDGES + 1 do
		rings[i] = {}
	end
	for i = 1, heapN do
		local d = heapD[i]
		local ring = #RING_EDGES + 1
		for r = 1, #RING_EDGES do
			if d <= RING_EDGES[r] then
				ring = r
				break
			end
		end
		local bucket = rings[ring]
		bucket[#bucket + 1] = heapP[i]
		heapP[i] = nil
	end
	heapN = 0
	clearTable(nearbyList)
	clearTable(nearbySet)
	local n = 0
	for r = 1, #rings do
		local bucket = rings[r]
		for j = 1, #bucket do
			n = n + 1
			nearbyList[n] = bucket[j]
			nearbySet[bucket[j]] = true
		end
	end
	for part, st in pairs(casterStates) do
		if not nearbySet[part] then
			removeCasterContribs(st)
			casterStates[part] = nil
		end
	end
	bakeCursor = 1
	scan.active = false
	scan.lastEnd = wallNow()
end

-- Looks for casters around the camera a slice at a time (no frame hitch on big maps).
function stepCasterScan(now)
	if not scan.active then
		local moved = (camPos - scan.focus).Magnitude
		if now - scan.lastEnd >= CONFIG.MapRefreshInterval
			and (moved > 12 or #nearbyList == 0 or casterVersion - scan.version > 150 or now - scan.lastEnd > 20) then
			scan.active = true
			scan.cursor = 1
			scan.focus = camPos
			scan.version = casterVersion
			heapN = 0
			heapK = math.max(80, math.floor(CONFIG.MaxMapCasters * (0.4 + 0.6 * qualityLevel)))
		else
			return
		end
	end
	local n = #casterList
	local last = math.min(n, scan.cursor + CONFIG.ScanSlice - 1)
	local focus = scan.focus
	local maxD = effectiveRenderDistance()
	local ang = CONFIG.MinCasterAngularSize
	for i = scan.cursor, last do
		local part = casterList[i]
		if part then
			local pos = casterDyn[i] and part.Position or casterPos[i]
			local mag = casterMag[i]
			local d = (pos - focus).Magnitude
			local sd = d - mag * 0.5
			if sd <= maxD and (d < 90 or mag >= d * ang) then
				-- Importance = apparent size: a huge wall far away outranks a tiny prop up close.
				local key = (sd + 30) / (mag + 4)
				if heapN < heapK or key < heapKey[1] then
					-- Only now touch live properties: hidden parts never cast shadows.
					if part.Parent and isPartOpaqueEnough(part) then
						heapPush(key, sd, part)
					end
				end
			end
		end
	end
	scan.cursor = last + 1
	if scan.cursor > n then
		finishCasterScan()
	end
end

-- Nearest-first, time-budgeted baking. Static shadows are then left alone.
local lastOpaque = setmetatable({}, { __mode = "k" })
local lastFlipTime = -1e9
local BIG_PART_MAG = 25

function stepMapBaking(lightDir, deadline, now)
	local n = #nearbyList
	if n == 0 then
		return
	end
	if bakedLightDir == nil or (lightDir - bakedLightDir).Magnitude > math.rad(CONFIG.LightRebakeAngleDeg) then
		bakedLightDir = lightDir
		lightEpoch = lightEpoch + 1
	end
	local maxChecks = math.min(CONFIG.BakeChecksPerFrame, n)
	local minBakes = CONFIG.MinBakePerFrame
	local baked = 0
	for _ = 1, maxChecks do
		if bakeCursor > n then
			bakeCursor = 1
		end
		local part = nearbyList[bakeCursor]
		bakeCursor = bakeCursor + 1
		if part and part.Parent then
			local st = casterStates[part]
			local opaque = isPartOpaqueEnough(part)
			local was = lastOpaque[part]
			if was ~= opaque then
				lastOpaque[part] = opaque
				if was ~= nil then
					-- A big part (roof, wall) appearing/disappearing changes what shades
					-- everything around it: re-bake the neighbourhood (rate limited).
					local idx = casterIndex[part]
					if idx and casterMag[idx] >= BIG_PART_MAG and now - lastFlipTime > 0.5 then
						lastFlipTime = now
						lightEpoch = lightEpoch + 1
					end
				end
			end
			if not opaque then
				if st then
					removeCasterContribs(st)
					casterStates[part] = nil
				end
			else
				local need = false
				if not st or st.epoch ~= lightEpoch then
					need = true
				elseif part.CFrame ~= st.cf or part.Size ~= st.size then
					need = (not st.dynamic) or (now - st.bakedAt >= 0.15)
				end
				if need and (baked < minBakes or os.clock() < deadline) then
					bakeCaster(part, st, lightDir, now)
					baked = baked + 1
				end
			end
		end
	end
end

end

-- ============================================================================
-- MAIN PER-FRAME PIPELINE
-- ============================================================================
local function computeLightDirection()
	local sunRaw = Lighting:GetSunDirection()
	local rawY = sunRaw.Y
	local dir, strength
	local function fade(y)
		if not CONFIG.FadeWithSunElevation then
			return (y > -0.02) and 1 or 0
		end
		return smoothstep(-0.01, 0.16, y)
	end
	if sunRaw.Y >= 0 then
		dir = sunRaw
		strength = fade(sunRaw.Y)
	else
		dir = Lighting:GetMoonDirection()
		rawY = dir.Y
		strength = CONFIG.NightShadowStrength * fade(dir.Y)
	end

	local minEl = math.clamp(CONFIG.MinSunElevation, 0.05, 0.99)
	if dir.Y < minEl then
		local horiz = Vector3.new(dir.X, 0, dir.Z)
		if horiz.Magnitude < 1e-4 then
			horiz = VEC3_X
		end
		dir = horiz.Unit * math.sqrt(1 - minEl * minEl) + VEC3_Y * minEl
	end
	return -dir.Unit, dir.Unit, strength, rawY
end

local function getCharacterRoot(model)
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Head")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function releaseCharacterState(model)
	local state = charStates[model]
	if state then
		for _, proj in pairs(state.projectors) do
			destroyProjector(proj)
		end
		clearTable(state.projectors)
		charStates[model] = nil
	end
end

-- Adaptive quality: sheds work when the frame rate drops, recovers slowly. The limit is
-- relative to the fastest sustained frame time this device reached (so a phone that did
-- 80 fps and now does 55 is "lagging" even though 55 is fine in absolute terms), and never
-- laxer than TargetFps.
local perf = { avgDt = 1 / 60, bestDt = 1 / 30, limit = 1 / 45, timer = 0, frameMs = 0 }
local function updateGovernor(dt)
	perf.avgDt = perf.avgDt + (math.min(dt, 0.2) - perf.avgDt) * 0.05
	if frameCounter > 150 then
		if perf.avgDt < perf.bestDt then
			perf.bestDt = perf.avgDt
		else
			perf.bestDt = perf.bestDt + (perf.avgDt - perf.bestDt) * 0.0015
		end
	end
	perf.timer = perf.timer + dt
	if perf.timer < 0.5 then
		return
	end
	perf.timer = 0
	if not CONFIG.AutoQuality then
		qualityLevel = 1
		lodStep = 1
		return
	end
	local limit = math.min(math.clamp(perf.bestDt * 1.25, 1 / 90, 1 / 30), 1 / CONFIG.TargetFps)
	perf.limit = limit
	if perf.avgDt > limit * 1.05 then
		qualityLevel = math.max(CONFIG.MinQuality, qualityLevel - 0.08)
	elseif perf.avgDt < limit * 0.9 then
		qualityLevel = math.min(1, qualityLevel + 0.04)
	end
	if qualityLevel < 0.5 then
		lodStep = 0.6
	elseif qualityLevel > 0.7 then
		lodStep = 1
	end
end

local function collectStats()
	local bound, total, prims, queue = getTileStats()
	local baked, projectors = 0, 0
	for _ in pairs(casterStates) do
		baked = baked + 1
	end
	for _ in ipairs(allProjectors) do
		projectors = projectors + 1
	end
	return {
		version = VERSION,
		quality = qualityLevel,
		fps = 1 / math.max(perf.avgDt, 1e-4),
		scriptMsPerFrame = perf.frameMs,
		limitMs = perf.limit * 1000,
		lodScale = math.min(lodStep, lodBudgetStep),
		boundTiles = bound,
		totalTiles = total,
		shadowPrimitives = prims,
		casterCandidates = #casterList,
		casterNearby = #nearbyList,
		castersBaked = baked,
		tileBuildQueue = queue,
		silhouetteProjectors = projectors,
	}
end

-- ============================================================================
-- ON-SCREEN DEBUG OVERLAY (Debug = true): readable on a phone, shows where time goes
-- ============================================================================
local phases = { chars = 0, scan = 0, bake = 0, tiles = 0, fx = 0 }   -- peak ms since the last refresh
local overlay = { gui = nil, label = nil, nextUpdate = 0, sunRaw = 0, sunUsed = 0, strength = 0 }

local ensureOverlay
do
function ensureOverlay()
	if overlay.label then
		return true
	end
	local parent = nil
	pcall(function()
		if gethui then
			parent = gethui()
		end
	end)
	if not parent then
		pcall(function()
			parent = game:GetService("CoreGui")
		end)
	end
	if not parent then
		pcall(function()
			local lp = Players.LocalPlayer
			parent = lp and lp:FindFirstChildOfClass("PlayerGui")
		end)
	end
	if not parent then
		return false
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "StencilShadowDebug"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 2147483647
	local label = Instance.new("TextLabel")
	label.BackgroundColor3 = Color3.new(0, 0, 0)
	label.BackgroundTransparency = 0.3
	label.BorderSizePixel = 0
	label.AnchorPoint = Vector2.new(1, 0)
	label.Position = UDim2.new(1, -4, 0, 96)
	label.Size = UDim2.new(0, 330, 0, 150)
	label.Font = Enum.Font.Code
	label.TextSize = 11
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Text = ""
	label.Parent = gui
	local ok = pcall(function()
		gui.Parent = parent
	end)
	if not ok then
		pcall(function()
			gui:Destroy()
		end)
		return false
	end
	overlay.gui, overlay.label = gui, label
	return true
end
end

local function updateOverlay(now, localChar)
	if now < overlay.nextUpdate then
		return
	end
	overlay.nextUpdate = now + 0.5
	if not ensureOverlay() then
		return
	end
	local s = collectStats()
	local el = function(y)
		return math.deg(math.asin(math.clamp(y, -1, 1)))
	end
	local lines = {}
	lines[1] = string.format("StencilShadow %s q%.2f %dfps lim%.0fms%s", VERSION, s.quality, math.floor(s.fps + 0.5), s.limitMs, usingMobilePreset and " mobile" or "")
	lines[2] = string.format("script %.1fms res x%.2f", s.scriptMsPerFrame, s.lodScale)
	lines[3] = string.format("peak ch%.1f sc%.1f bk%.1f ti%.1f fx%.1f ms", phases.chars, phases.scan, phases.bake, phases.tiles, phases.fx)
	for k in pairs(phases) do
		phases[k] = 0
	end
	lines[4] = string.format("tiles %d/%d q%d prims %d", s.boundTiles, s.totalTiles, s.tileBuildQueue, s.shadowPrimitives)
	lines[5] = string.format("casters %d/%d baked %d", s.casterNearby, s.casterCandidates, s.castersBaked)
	lines[6] = string.format("sun %.0fdeg (used %.0f) s%.2f", el(overlay.sunRaw), el(overlay.sunUsed), overlay.strength)
	local st = localChar and charStates[localChar]
	if st then
		local dg = st.diag
		local first = st.parts[1]
		lines[7] = string.format("YOU lit%.2f parts%d planes%s/%s st%s", first and first.lit or -1, #st.parts,
			tostring(dg.usable), tostring(dg.planes), tostring(dg.statics))
		lines[8] = string.format("%s on %s sil%s/%s core%s", dg.haveFloor and (dg.floorShaded and "SHADED" or "lit") or "nofloor",
			tostring(dg.floorPart), tostring(dg.silPlaced), tostring(dg.silAllowed and 1 or 0), dg.core and "on" or "off")
	else
		lines[7] = "YOU: no character yet"
	end
	lines[#lines + 1] = "err " .. string.sub(lastErrorText, 1, 46)
	overlay.label.Size = UDim2.new(0, 330, 0, #lines * 13 + 6)
	overlay.label.Text = table.concat(lines, "\n")
end

local lastDebugPrint = wallNow()
local charScratch = {}

local conn = RunService.RenderStepped:Connect(function(dt)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local frameStart = os.clock()
	dt = math.clamp(dt or 1 / 60, 0, 0.25)
	frameCounter = frameCounter + 1
	updateCameraCache(camera)
	updateGovernor(dt)

	if frameCounter % 30 == 1 then
		if CONFIG.ForceDisableNativeShadows and Lighting.GlobalShadows then
			pcall(function()
				Lighting.GlobalShadows = false
			end)
		end
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			if char and not characterModels[char] then
				markCharacter(char)
			end
		end
	end
	if ignoreListDirty then
		rebuildGlobalIgnoreList()
		rayParams.FilterDescendantsInstances = globalRaycastIgnoreList
	end

	local dbg = CONFIG.Debug
	local tPhase = dbg and os.clock() or 0
	local lightDir, sunDir, strength, rawSunY = computeLightDirection()
	overlay.sunRaw, overlay.sunUsed, overlay.strength = rawSunY, sunDir.Y, strength
	currentShadowStrength = strength
	currentGroupTransparency = 1 - math.clamp(CONFIG.ShadowDarkness * strength, 0, 1)
	local shadowsOn = strength > 0.01
	local now = wallNow()

	local localPlayer = Players.LocalPlayer
	local localChar = localPlayer and localPlayer.Character

	-- 1. CHARACTERS (exact silhouettes near the camera, cheaper shapes further out)
	clearTable(charScratch)
	for model in pairs(characterModels) do
		if model.Parent then
			local root = getCharacterRoot(model)
			if root then
				local isLocal = (model == localChar)
				local d = isLocal and 0 or (root.Position - camPos).Magnitude
				if d <= CONFIG.MaxCharacterDistance then
					charScratch[#charScratch + 1] = { model = model, root = root, dist = d, isLocal = isLocal }
				end
			end
		else
			characterModels[model] = nil
			ignoreListDirty = true
			releaseCharacterState(model)
		end
	end
	table.sort(charScratch, function(a, b)
		return a.dist < b.dist
	end)

	local maxSil = math.max(1, math.floor(CONFIG.MaxSilhouetteCharacters * qualityLevel + 0.5))
	local silhouettesUsed = 0
	-- How far a character's shadow can reach (low sun = long shadows).
	local shadowReach = math.clamp(10 / math.max(-lightDir.Y, 0.15), 12, 90) + 8
	for rank, c in ipairs(charScratch) do
		local state = getCharacterState(c.model)
		state.root = c.root
		state.lastSeenFrame = frameCounter
		-- Characters whose shadow cannot be on screen cost nothing.
		if c.isLocal or isSphereOnScreen(c.root.Position, shadowReach) then
			local detailed = c.isLocal or (rank <= 3 and c.dist < 120)
			updateCharacterLighting(state, dt)
			if c.dist < 300 then
				queueSelfShadow(state, c.dist)
			end

			if shadowsOn then
				local allow = c.dist < CONFIG.SilhouetteDistance and silhouettesUsed < maxSil
				if allow then
					silhouettesUsed = silhouettesUsed + 1
					state.lastAllowedFrame = frameCounter
				end
				local ok, err = pcall(renderCharacterShadow, state, lightDir, c.dist, allow, c.isLocal)
				if not ok then
					reportError("character", err)
				end
			else
				for _, proj in pairs(state.projectors) do
					setProjectorEnabled(proj, false)
				end
			end
		else
			for _, proj in pairs(state.projectors) do
				setProjectorEnabled(proj, false)
			end
		end
	end

	-- Free silhouette clones of characters that left the area.
	if frameCounter % 60 == 0 then
		for model, state in pairs(charStates) do
			if frameCounter - (state.lastSeenFrame or 0) > 240 or not model.Parent then
				releaseCharacterState(model)
			elseif frameCounter - (state.lastAllowedFrame or 0) > 600 and next(state.projectors) then
				for _, proj in pairs(state.projectors) do
					destroyProjector(proj)
				end
				clearTable(state.projectors)
			elseif frameCounter - (state.lastSeenFrame or 0) > 2 then
				for _, proj in pairs(state.projectors) do
					setProjectorEnabled(proj, false)
				end
			end
		end
	end

	if dbg then
		local t = os.clock()
		phases.chars = math.max(phases.chars, (t - tPhase) * 1000)
		tPhase = t
	end

	-- 2. MAP CASTERS (retained: bake once, then nothing per frame)
	if shadowsOn and CONFIG.IncludeMapParts then
		stepCasterScan(now)
		if dbg then
			local t = os.clock()
			phases.scan = math.max(phases.scan, (t - tPhase) * 1000)
			tPhase = t
		end
		local scale = 0.4 + 0.6 * qualityLevel
		stepMapBaking(lightDir, os.clock() + CONFIG.BakeBudgetSeconds * scale, now)
		if dbg then
			local t = os.clock()
			phases.bake = math.max(phases.bake, (t - tPhase) * 1000)
			tPhase = t
		end
	end

	-- 3. TILES (visibility / LOD pass, then budgeted canvas (re)builds)
	refreshTileStates(now)
	processTileQueue(os.clock() + CONFIG.TileBuildBudgetSeconds * (0.4 + 0.6 * qualityLevel))
	if dbg then
		local t = os.clock()
		phases.tiles = math.max(phases.tiles, (t - tPhase) * 1000)
		tPhase = t
	end

	applySelfShadowHighlights()
	finalizeCanvasSlotsForFrame()
	if dbg then
		phases.fx = math.max(phases.fx, (os.clock() - tPhase) * 1000)
		updateOverlay(now, localChar)
	end

	perf.frameMs = perf.frameMs + ((os.clock() - frameStart) * 1000 - perf.frameMs) * 0.1
	if CONFIG.Debug and now - lastDebugPrint > 5 then
		lastDebugPrint = now
		local s = collectStats()
		print(string.format("[StencilShadow %s] q=%.2f fps=%.0f script=%.2fms tiles=%d/%d prims=%d casters=%d/%d baked=%d queue=%d sil=%d",
			VERSION, s.quality, s.fps, s.scriptMsPerFrame, s.boundTiles, s.totalTiles, s.shadowPrimitives,
			s.casterNearby, s.casterCandidates, s.castersBaked, s.tileBuildQueue, s.silhouetteProjectors))
	end
end)
track(conn)

globalEnv._StencilShadowConnection = conn
globalEnv.StencilShadowStats = collectStats
globalEnv._StencilShadowCleanup = function()
	for _, c in ipairs(trackedConnections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	pcall(function()
		shadowContainer:Destroy()
	end)
	if originalGlobalShadows ~= nil then
		pcall(function()
			Lighting.GlobalShadows = originalGlobalShadows
		end)
	end
	globalEnv.StencilShadowStats = nil
end

print("[StencilShadow " .. VERSION .. "] running | " .. (usingMobilePreset and "MOBILE preset" or "desktop preset")
	.. " | range " .. tostring(math.floor(CONFIG.MaxRenderDistance)) .. " studs | AutoQuality " .. tostring(CONFIG.AutoQuality)
	.. (CONFIG.Debug and " | on-screen diagnostics ON (Debug = false hides them)" or ""))

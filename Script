-- ============================================================================
-- Games and cameras hide parts locally (roof hiding, invisicam, fade-outs) via
-- LocalTransparencyModifier or by toggling Transparency at runtime. A part that is
-- invisible must neither cast a shadow nor block the sun.
local function getEffectiveTransparency(part)
	local t = part.Transparency
	local l = part.LocalTransparencyModifier
	if l > 0 then
		return 1 - (1 - t) * (1 - l)
	end
	return t
end

local function isPartOpaqueEnough(part)
	local t = getEffectiveTransparency(part)
	if t > CONFIG.MaxTransparentPartAlpha then
		return false
	end
	if t > 0.05 and not part.CanCollide then
		return false
	end
	return true
end

